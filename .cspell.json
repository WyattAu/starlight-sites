  "flagWords": ["obviously", "clearly", "trivially", "intuitively"],
  "ignorePaths": [
    "node_modules",
    "dist",
    ".astro",
    "bun.lock",
    "package-lock.json",
    "*.min.js",
    "*.min.css"
  ],
  "ignoreRegExpList": [
    "\\$\\$[\\s\\S]*?\\$\\$",
    "\\$[^$]+\\$",
    "`[^`]+`",
    "https?://[^\\s]+",
    "<aside[^>]*>",
    "data-[a-z-]+="
  ],
  "minWordLength": 3
}
