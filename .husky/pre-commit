#!/usr/bin/env sh
# Pre-commit gate (husky v9).
#
# Strict, fast: runs targeted per-file checks via lint-staged (no-emoji,
# content, config on staged files) plus two tree-wide gates that lint-staged
# cannot cover -- shared-asset sync integrity and the unit + integration test
# suite. The full repo-wide content/no-emoji walk additionally runs in CI on
# every push/PR, so enforcement is layered: changed files here, whole tree CI.
#
# Any failure aborts the commit.

echo "Running pre-commit checks..."

# 1. Shared-asset integrity: every site must match the canonical shared/ source.
node scripts/sync-shared.mjs --check
status=$?
if [ "$status" -ne 0 ]; then
  echo "Pre-commit FAILED: shared assets drifted. Run 'bun run sync' and re-stage."
  exit 1
fi

# 2. Unit + integration tests (pure-Node; the canonical correctness gate).
node --test tests/unit/*.test.js tests/integration/*.test.js
status=$?
if [ "$status" -ne 0 ]; then
  echo "Pre-commit FAILED: unit/integration tests failed."
  exit 1
fi

echo "Pre-commit checks passed."
