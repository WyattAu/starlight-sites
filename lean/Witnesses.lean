/-! From `stage-b-counting.md` -/

theorem zero_add_w (n : Nat) : 0 + n = n := by
  induction n with
  | zero => rfl
  | succ k ih => rw [Nat.add_succ, ih]

theorem add_comm_w (a b : Nat) : a + b = b + a := by
  induction b with
  | zero => rw [Nat.add_zero, Nat.zero_add]
  | succ k ih => rw [Nat.add_succ, Nat.succ_add, ih]

/-! From `stage-b-counting.md` -/

theorem division_with_remainder_w (a b : Nat) :
    b * (a / b) + a % b = a := Nat.div_add_mod a b

theorem mod_lt_w (a b : Nat) (h : b ≠ 0) : a % b < b :=
  Nat.mod_lt a (by omega)

/-! From `stage-c-expanding-the-line.md` -/

theorem add_wd (a b c d a' b' c' d' : Nat)
    (h1 : a + b' = a' + b) (h2 : c + d' = c' + d) :
    a + c + (b' + d') = a' + c' + (b + d) := by omega

/-! From `stage-e-completing-algebra.md` -/

def evalPoly (coef : List Nat) (x : Nat) : Nat :=
  match coef with
  | [] => 0
  | a :: rest => a + x * evalPoly rest x

theorem eval_nil_w (x : Nat) : evalPoly [] x = 0 := rfl

theorem eval_cons_w (a : Nat) (coef : List Nat) (x : Nat) :
    evalPoly (a :: coef) x = a + x * evalPoly coef x := rfl
