{
  "name": "starlight-sites",
  "version": "1.0.0",
  "private": true,
  "description": "Wyatt's Notes -- Starlight monorepo (45 sites + landing, cross-site search API); site list derived from sites/ (ADR-011)",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:content": "node scripts/lint-content.js",
    "lint:config": "node scripts/lint-config.js",
    "lint:no-emoji": "node scripts/lint-no-emoji.js",
    "lint:links": "node scripts/lint-links.js",
    "lint:handwaves": "node scripts/lint-handwaves.js",
    "lint:descriptions": "node scripts/lint-descriptions.js",
    "lint:depth": "node scripts/lint-depth.js",
    "lint:forward-refs": "node scripts/lint-forward-refs.js",
    "lint:latex": "node scripts/lint-latex.js",
    "lint:spelling": "cspell \"shared/**/*.ts\" \"shared/**/*.tsx\" \"scripts/**/*.{js,mjs}\" \"search-api/**/*.{js,mjs}\"",
    "lint:capitalisation": "node scripts/lint-capitalisation.js",
    "lint:markdown": "markdownlint \"sites/*/src/content/docs/**/*.md\" \"sites/*/src/content/docs/**/*.mdx\"",
    "lint:all": "biome check . && node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-config-parity.js && node scripts/lint-no-emoji.js && node scripts/lint-practice-components.js && node scripts/lint-links.js && node scripts/lint-handwaves.js && node scripts/lint-descriptions.js && node scripts/lint-depth.js && node scripts/lint-forward-refs.js && node scripts/lint-latex.js && node scripts/lint-secrets.js",
    "lint:secrets": "node scripts/lint-secrets.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "build:site": "bunx astro build",
    "test": "vitest run && node --test --experimental-test-coverage tests/unit/*.test.js tests/integration/*.test.js",
    "test:components": "vitest run tests/components",
    "test:legacy": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:gui": "node tests/e2e/gui-snapshot.js",
    "test:contrast": "node tests/e2e/contrast-check.js",
    "test:e2e": "bunx playwright test --config=tests/e2e/playwright.config.ts",
    "test:all": "vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js && node tests/e2e/gui-snapshot.js --all",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "verify": "biome check . && vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js && node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js && node scripts/lint-practice-components.js && node scripts/lint-handwaves.js && node scripts/lint-descriptions.js && node scripts/lint-depth.js",
    "generate": "node scripts/generate-site.mjs"
  },
  "workspaces": [
    "sites/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "astro-compress": "^2.4.3",
    "axe-core": "^4.14.0",
    "cspell": "^8.19.4",
    "dompurify": "^3.4.17",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "markdownlint-cli": "^0.49.1",
    "playwright": "^1.64.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^4.1.12",
    "web-vitals": "^5.3.0",
    "wrangler": "^4.156.2"
  },
  "overrides": {
    "astro": "^6.1.10",
    "devalue": "^5.9.2",
    "vite": "^6.4.4",
    "katex": "^0.18.2",
    "mermaid": "^11.16.1",
    "dompurify": "^3.4.11",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.0",
    "zod": "^4.6.6",
    "postcss": "^8.5.23",
    "undici": "^7.29.0",
    "browserslist": "^4.28.7",
    "nanoid": "^3.3.16",
    "minimatch": "^11.0.1",
    "js-yaml": "^4.3.0",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2",
    "svgo": "^4.0.2",
    "brace-expansion": "^5.0.8",
    "baseline-browser-mapping": "^2.11.0",
    "deepmerge-ts": "^8.0.0"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "node scripts/lint-content.js",
      "node scripts/lint-handwaves.js",
      "node scripts/lint-descriptions.js",
      "node scripts/lint-latex.js"
    ],
    "sites/*/astro.config.mjs": [
      "node scripts/lint-config.js",
      "node scripts/lint-config-parity.js"
    ],
    "*.{js,mjs,ts,tsx,astro,yml,yaml,json,toml,html}": [
      "node scripts/lint-no-emoji.js",
      "node scripts/lint-secrets.js",
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "prepare": "husky",
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@iconify-json/lucide": "^1.2.150",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/i18n": "^2.2.1",
    "solid-js": "^1.9.18",
    "solid-sonner": "^0.3.3",
    "unplugin-icons": "^23.0.1"
  }
}
