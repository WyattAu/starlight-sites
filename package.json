{
  "name": "starlight-sites",
  "version": "1.0.0",
  "private": true,
  "description": "Wyatt's Notes -- Starlight monorepo (9 sub-sites, cross-site search API)",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:content": "node scripts/lint-content.js",
    "lint:config": "node scripts/lint-config.js",
    "lint:no-emoji": "node scripts/lint-no-emoji.js",
    "lint:links": "node scripts/lint-links.js",
    "lint:all": "biome check . && node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js && node scripts/lint-links.js",
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "build:site": "bunx astro build",
    "test": "vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "vitest run tests/components",
    "test:components": "vitest run tests/components",
    "test:legacy": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:gui": "node tests/e2e/gui-snapshot.js",
    "test:e2e": "bunx playwright test --config=tests/e2e/playwright.config.ts",
    "test:all": "vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js && node tests/e2e/gui-snapshot.js --all",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "verify": "biome check . && vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js && node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js",
    "generate": "node scripts/generate-site.mjs"
  },
  "workspaces": [
    "sites/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.61.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.1",
    "happy-dom": "^20.10.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.4.3",
    "tailwindcss": "^4.3.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{md,mdx}": "node scripts/lint-content.js",
    "sites/*/astro.config.mjs": "node scripts/lint-config.js",
    "*.{js,mjs,ts,tsx,astro,yml,yaml,json,toml,html}": [
      "node scripts/lint-no-emoji.js",
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "prepare": "husky",
  "dependencies": {
    "@felte/core": "^1.4.4",
    "@iconify-json/lucide": "^1.2.113",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/keyboard": "^1.3.5",
    "@solid-primitives/media": "^2.3.5",
    "@solid-primitives/utils": "^6.4.0",
    "solid-js": "^1.9.13",
    "unplugin-icons": "^23.0.1"
  }
}
