{
  "name": "starlight-sites",
  "version": "1.0.0",
  "private": true,
  "description": "Wyatt's Notes -- Starlight monorepo (9 sub-sites, cross-site search API)",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:content": "node scripts/lint-content.js",
    "lint:config": "node scripts/lint-config.js",
    "lint:no-emoji": "node scripts/lint-no-emoji.js",
    "lint:links": "node scripts/lint-links.js",
    "lint:handwaves": "node scripts/lint-handwaves.js",
    "lint:descriptions": "node scripts/lint-descriptions.js",
    "lint:depth": "node scripts/lint-depth.js",
    "lint:forward-refs": "node scripts/lint-forward-refs.js",
    "lint:spelling": "cspell \"sites/*/src/content/docs/**/*.md\" \"sites/*/src/content/docs/**/*.mdx\" \"shared/**/*.ts\" \"shared/**/*.tsx\"",
    "lint:markdown": "markdownlint \"sites/*/src/content/docs/**/*.md\" \"sites/*/src/content/docs/**/*.mdx\"",
    "lint:all": "biome check . && node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js && node scripts/lint-links.js && node scripts/lint-handwaves.js && node scripts/lint-descriptions.js && node scripts/lint-depth.js && node scripts/lint-forward-refs.js",
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "build:site": "bunx astro build",
    "test": "vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:components": "vitest run tests/components",
    "test:legacy": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:gui": "node tests/e2e/gui-snapshot.js",
    "test:contrast": "node tests/e2e/contrast-check.js",
    "test:e2e": "bunx playwright test --config=tests/e2e/playwright.config.ts",
    "test:all": "vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js && node tests/e2e/gui-snapshot.js --all",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "verify": "biome check . && vitest run && node --test tests/unit/*.test.js tests/integration/*.test.js && node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js && node scripts/lint-handwaves.js && node scripts/lint-descriptions.js && node scripts/lint-depth.js",
    "generate": "node scripts/generate-site.mjs"
  },
  "workspaces": [
    "sites/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@jdevalk/astro-seo-graph": "^2.0.0",
    "@playwright/test": "^1.61.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "astro-compress": "^2.4.1",
    "astro-seo": "^1.1.0",
    "axe-core": "^4.12.1",
    "cspell": "^8.17.0",
    "dompurify": "^3.2.4",
    "happy-dom": "^20.10.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.4.3",
    "markdownlint-cli": "^0.49.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.3.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9",
    "web-vitals": "^5.3.0"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "node scripts/lint-content.js",
      "node scripts/lint-handwaves.js",
      "node scripts/lint-descriptions.js"
    ],
    "sites/*/astro.config.mjs": "node scripts/lint-config.js",
    "*.{js,mjs,ts,tsx,astro,yml,yaml,json,toml,html}": [
      "node scripts/lint-no-emoji.js",
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "prepare": "husky",
  "dependencies": {
    "@felte/core": "^1.4.4",
    "@felte/validator-zod": "^1.0.18",
    "@formkit/auto-animate": "^0.9.0",
    "@iconify-json/lucide": "^1.2.113",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/i18n": "^2.2.1",
    "solid-js": "^1.9.13",
    "solid-sonner": "^0.3.1",
    "unplugin-icons": "^23.0.1",
    "zod": "^4.4.3"
  }
}
