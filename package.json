{
  "name": "starlight-sites",
  "version": "1.0.0",
  "private": true,
  "description": "Wyatt's Notes -- Starlight monorepo (9 sub-sites, cross-site search API)",
  "scripts": {
    "lint:content": "node scripts/lint-content.js",
    "lint:config": "node scripts/lint-config.js",
    "lint:no-emoji": "node scripts/lint-no-emoji.js",
    "lint:links": "node scripts/lint-links.js",
    "lint": "node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js",
    "lint:all": "node scripts/lint-content.js && node scripts/lint-config.js && node scripts/lint-no-emoji.js && node scripts/lint-links.js",
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "build:site": "bunx astro build",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:gui": "node tests/e2e/gui-snapshot.js",
    "test:e2e": "bunx playwright test --config=tests/e2e/playwright.config.ts",
    "test:all": "node --test tests/unit/*.test.js tests/integration/*.test.js && node tests/e2e/gui-snapshot.js --all",
    "verify": "node scripts/lint-no-emoji.js && node scripts/lint-content.js && node scripts/lint-config.js && node --test tests/unit/*.test.js tests/integration/*.test.js",
    "generate": "node scripts/generate-site.mjs"
  },
  "workspaces": [
    "sites/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "*.{md,mdx}": "node scripts/lint-content.js",
    "sites/*/astro.config.mjs": "node scripts/lint-config.js",
    "*.{js,mjs,ts,tsx,astro,yml,yaml,json,toml,html}": "node scripts/lint-no-emoji.js"
  },
  "prepare": "husky"
}
