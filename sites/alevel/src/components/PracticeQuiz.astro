---
interface Props {
  question: string;
  options: string[];
  correct: number;
  explanation?: string;
}

const { question, options, correct, explanation } = Astro.props;
const quizId = `quiz-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="practice-quiz" data-correct={correct}>
  <div class="quiz-question">{question}</div>
  <div class="quiz-options">
    {options.map((option, index) => (
      <label class="quiz-option">
        <input type="radio" name={quizId} value={index} />
        <span class="option-text">{option}</span>
      </label>
    ))}
  </div>
  <button class="quiz-submit" type="button">Check Answer</button>
  <div class="quiz-feedback"></div>
  {explanation && <div class="quiz-explanation">{explanation}</div>}
</div>

<script>
  document.querySelectorAll('.practice-quiz').forEach(quiz => {
    const correct = parseInt(quiz.dataset.correct);
    const feedback = quiz.querySelector('.quiz-feedback');
    const submitBtn = quiz.querySelector('.quiz-submit');
    
    submitBtn.addEventListener('click', () => {
      const selected = quiz.querySelector('input:checked');
      if (!selected) {
        feedback.textContent = 'Please select an answer';
        feedback.className = 'quiz-feedback error';
        return;
      }
      
      const isCorrect = parseInt(selected.value) === correct;
      feedback.textContent = isCorrect ? 'Correct!' : 'Incorrect. Try again.';
      feedback.className = `quiz-feedback ${isCorrect ? 'success' : 'error'}`;
    });
  });
</script>

<style>
  .practice-quiz {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }
  .quiz-question {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .quiz-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .quiz-option:hover {
    background: var(--sl-color-gray-5);
  }
  .quiz-option input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--sl-color-accent);
  }
  .quiz-submit {
    background: var(--sl-color-accent);
    color: white;
    border: none;
    padding: 0.5rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .quiz-submit:hover {
    background: var(--sl-color-accent-hover);
  }
  .quiz-feedback {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 8px;
    display: none;
  }
  .quiz-feedback.success {
    display: block;
    background: rgba(6, 214, 160, 0.1);
    color: #06d6a0;
  }
  .quiz-feedback.error {
    display: block;
    background: rgba(239, 71, 111, 0.1);
    color: #ef476f;
  }
  .quiz-explanation {
    margin-top: 1rem;
    padding: 1rem;
    background: var(--sl-color-gray-5);
    border-radius: 8px;
    font-size: 0.9rem;
  }
</style>
