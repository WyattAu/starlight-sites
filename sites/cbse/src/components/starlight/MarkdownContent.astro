---
// Custom MarkdownContent that adds progress tracking at the bottom
const { starlightRoute } = Astro.locals;
const pageId = starlightRoute.entry.id;
---

<div class="sl-markdown-content markdown-content">
  <slot />
</div>

<div class="progress-tracker" data-page-id={pageId}>
  <label class="progress-label">
    <input type="checkbox" class="progress-checkbox" />
    <span class="progress-text">Mark this page as reviewed</span>
  </label>
</div>

<script>
  document.querySelectorAll('.progress-tracker').forEach(tracker => {
    const checkbox = tracker.querySelector('.progress-checkbox') as HTMLInputElement;
    const pageId = (tracker as HTMLElement).dataset.pageId;
    const key = `wn_progress_${pageId}`;

    // Load saved state
    const saved = localStorage.getItem(key);
    if (saved === 'true') {
      checkbox.checked = true;
      tracker.classList.add('completed');
    }

    // Save on change
    checkbox.addEventListener('change', () => {
      localStorage.setItem(key, checkbox.checked.toString());
      tracker.classList.toggle('completed', checkbox.checked);
    });
  });
</script>

<style>
  .markdown-content :global(> :first-child) {
    margin-top: 0;
  }
  .progress-tracker {
    margin: 2rem 0 1rem;
    padding: 0.75rem 1rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
  }
  .progress-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .progress-checkbox {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--sl-color-accent);
  }
  .progress-text {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .progress-tracker.completed .progress-text {
    color: var(--sl-color-accent);
  }
</style>
