---
const { starlightRoute } = Astro.locals;
const siteTitle = starlightRoute?.siteTitle || "Notes";

const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: 'Exam Boards', url: 'https://exam-boards.wyattau.com' },
  { name: 'Languages Hub', url: 'https://languages.wyattau.com' },
  { name: 'Mathematics', url: 'https://mathematics.wyattau.com' },
  { name: 'Physics', url: 'https://physics.wyattau.com' },
  { name: 'Tools', url: 'https://tools.wyattau.com' },
];
---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-section footer-about">
      <h3>{siteTitle}</h3>
      <p>A comprehensive learning resource built with Starlight.</p>
      <div class="footer-social">
        <a href="https://github.com/WyattAu" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://twitter.com/PyHech" target="_blank" rel="noopener" aria-label="Twitter/X">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul class="footer-links">
        {quickLinks.map(link => (
          <li><a href={link.url} target="_blank" rel="noopener">{link.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-section">
      <h4>Site Statistics</h4>
      <ul class="footer-stats">
        <li><span class="stat-label">Total Sites</span><span class="stat-value">35+</span></li>
        <li><span class="stat-label">Languages</span><span class="stat-value">11</span></li>
        <li><span class="stat-label">Exam Boards</span><span class="stat-value">11</span></li>
        <li><span class="stat-label">Subjects</span><span class="stat-value">8+</span></li>
      </ul>
    </div>

    <div class="footer-section footer-newsletter">
      <h4>Stay Updated</h4>
      <p>Subscribe for new content and updates.</p>
      <form class="newsletter-form" onsubmit="return false;">
        <input type="email" placeholder="your@email.com" class="newsletter-input" />
        <button type="submit" class="newsletter-btn">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} WyattAu. Built with <a href="https://starlight.astro.build/" target="_blank" rel="noopener">Starlight</a> &amp; <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
    padding: 2.5rem 1.5rem 1rem;
    margin-top: 3rem;
    font-size: 0.85rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .footer-section h3,
  .footer-section h4 {
    color: var(--sl-color-white);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }
  .footer-section p {
    color: var(--sl-color-gray-3);
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }
  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .footer-social a {
    color: var(--sl-color-gray-3);
    transition: color 140ms ease;
  }
  .footer-social a:hover {
    color: var(--sl-color-accent);
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links li {
    margin-bottom: 0.4rem;
  }
  .footer-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 140ms ease;
  }
  .footer-links a:hover {
    color: var(--sl-color-accent);
  }
  .footer-stats {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-stats li {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    color: var(--sl-color-gray-3);
  }
  .stat-value {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .newsletter-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-size: 0.8rem;
    font-family: inherit;
  }
  .newsletter-input::placeholder {
    color: var(--sl-color-gray-5);
  }
  .newsletter-btn {
    padding: 0.5rem 1rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    border: none;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 140ms ease;
  }
  .newsletter-btn:hover {
    opacity: 0.9;
  }
  .footer-bottom {
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 2rem;
    padding-top: 1rem;
    text-align: center;
    color: var(--sl-color-gray-4);
    font-size: 0.8rem;
  }
  .footer-bottom a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .footer-bottom a:hover {
    color: var(--sl-color-accent);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
