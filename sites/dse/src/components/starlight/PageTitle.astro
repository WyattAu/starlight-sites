---
const { starlightRoute } = Astro.locals;
const { entry, id } = starlightRoute;

// PAGE_TITLE_ID is '_top' — hardcoded to avoid import resolution issues in overrides
const PAGE_TITLE_ID = '_top';

const siteTitle = starlightRoute?.siteTitle || "Notes";

// Build breadcrumb trail from the page id (the slug).
// e.g. "physics/1-mechanics/1_forces-and-motion" → [{label: "Home", href: "/"}, {label: "Physics", href: "/physics/"}, {label: "Forces and Motion"}]
function buildBreadcrumbs(id: string, siteTitle: string) {
  const parts = id.split('/').filter(Boolean);
  const crumbs = [{ label: 'Home', href: '/' }];

  // Add site name as second breadcrumb
  const hostname = Astro.url.hostname;
  const siteUrl = `https://${hostname}`;
  crumbs.push({ label: siteTitle, href: siteUrl });

  let path = '';
  for (let i = 0; i < parts.length; i++) {
    path += `/${parts[i]}`;
    const isLast = i === parts.length - 1;
    // Convert slug to readable label: "1_forces-and-motion" → "Forces and Motion"
    const label = parts[i]
      .replace(/^\d+-/, '')        // Remove leading number prefix
      .replace(/^\d+_/, '')        // Remove leading number_ prefix
      .replace(/[-_]/g, ' ')       // Replace hyphens/underscores with spaces
      .replace(/\b\w/g, c => c.toUpperCase()); // Capitalize words

    if (isLast) {
      crumbs.push({ label });
    } else {
      crumbs.push({ label, href: `${path}/` });
    }
  }
  return crumbs;
}

const breadcrumbs = buildBreadcrumbs(id, siteTitle);
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {breadcrumbs.map((item, index) => (
      <li>
        {item.href ? (
          <a href={item.href} class:list={[{ 'home-link': item.label === 'Home' }]}>
            {item.label === 'Home' ? (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            ) : item.label}
          </a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
        {index < breadcrumbs.length - 1 && (
          <span class="separator" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>

<style>
  .breadcrumbs {
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.25rem;
  }
  .breadcrumbs a {
    color: var(--sl-color-accent);
    text-decoration: none;
    padding: 0.15rem 0.3rem;
    border-radius: 0.25rem;
    transition: background 140ms ease, color 140ms ease;
  }
  .breadcrumbs a:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }
  .breadcrumbs a.home-link {
    color: var(--sl-color-accent);
    display: inline-flex;
    align-items: center;
  }
  .breadcrumbs .separator {
    margin: 0 0.1rem;
    color: var(--sl-color-gray-5);
    display: inline-flex;
    align-items: center;
    opacity: 0.6;
  }
  .breadcrumbs [aria-current="page"] {
    color: var(--sl-color-white);
    font-weight: 600;
    padding: 0.15rem 0.3rem;
  }
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
