---
// Search.astro — Custom cross-site search component for Starlight
// Replaces the default Pagefind search with our cross-site search API
---

<div id="custom-search">
  <button id="custom-search-btn" aria-label="Search all sites">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
  </button>
</div>

<script>
  (function() {
    function initSearch() {
      var btn = document.getElementById('custom-search-btn')
      if (!btn) return
      btn.addEventListener('click', function() {
        if (window.openSearchModal) {
          window.openSearchModal()
        } else {
          var input = document.querySelector('#cross-site-search-input')
          if (input) input.focus()
        }
      })
    }
    if (document.readyState === 'complete') initSearch()
    else document.addEventListener('DOMContentLoaded', initSearch)
  })()
</script>
