---
interface Props {
  widget: 'fourier-square' | 'sine'
  width?: number
  height?: number
  title?: string
}

const { widget, width = 600, height = 400, title } = Astro.props
const widgetId = `wasm-${widget}-${Math.random().toString(36).slice(2, 8)}`
---

<div class="wasm-widget-wrapper">
  {title && <p class="wasm-widget-title">{title}</p>}
  <canvas id={widgetId} width={width} height={height} class="wasm-canvas">
    Your browser does not support the canvas element.
  </canvas>
  {widget === 'fourier-square' && (
    <div class="wasm-controls">
      <label>
        Terms:
        <input type="range" id={`${widgetId}-terms`} min="1" max="50" value="10" class="wasm-slider" />
        <span id={`${widgetId}-terms-val`}>10</span>
      </label>
    </div>
  )}
</div>

<script define:vars={{ widget, widgetId }}>
  import('/wasm/starlight_widgets.js').then(async (mod) => {
    await mod.default()
    const canvas = document.getElementById(widgetId)
    if (!canvas) return
    const ctx = canvas.getContext('2d')

    const draw = () => {
      if (widget === 'fourier-square') {
        const slider = document.getElementById(`${widgetId}-terms`)
        const val = document.getElementById(`${widgetId}-terms-val`)
        const terms = parseInt(slider?.value || '10')
        if (val) val.textContent = String(terms)
        mod.draw_fourier_square(ctx, terms, canvas.width, canvas.height)
      } else if (widget === 'sine') {
        mod.draw_sine(ctx, canvas.width, canvas.height)
      }
    }

    draw()
    // Re-draw on slider change
    const slider = document.getElementById(`${widgetId}-terms`)
    if (slider) slider.addEventListener('input', draw)
  })
</script>

<style>
  .wasm-widget-wrapper {
    margin: 1.5rem 0;
    text-align: center;
  }
  .wasm-widget-title {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--wn-text-muted, #94a3b8);
  }
  .wasm-canvas {
    max-width: 100%;
    height: auto;
    border-radius: var(--wn-radius-lg, 18px);
    border: 1px solid var(--wn-border, #2a2a3e);
    background: var(--wn-bg, #0a0a0f);
  }
  .wasm-controls {
    margin-top: 0.75rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    align-items: center;
  }
  .wasm-controls label {
    font-size: 0.85rem;
    color: var(--wn-text-muted, #94a3b8);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wasm-slider {
    width: 120px;
    accent-color: var(--sl-color-accent, #ff6b35);
  }
</style>
