---
import ClientRouter from "astro/components/ClientRouter.astro"

const { starlightRoute } = Astro.locals;
const { entry, head } = starlightRoute;

const pageTitle = entry?.data?.title || "Untitled";
const siteTitle = starlightRoute?.siteTitle || "Wyatt's Notes";

const description = entry?.data?.description || 'Free, rigorous study notes';
const site = 'https://wyattsnotes.wyattau.com';
const pageUrl = Astro.url.href;

// Get the current date for schema fallback
const currentDate = new Date().toISOString();

// Use frontmatter dates if available, otherwise fallback to current date
const datePublished = entry?.data?.datePublished || entry?.data?.date || currentDate;
const dateModified = entry?.data?.dateModified || entry?.data?.date || currentDate;

// Determine the site name from the URL
const urlParts = new URL(pageUrl).hostname.split('.');
const subdomain = urlParts.length > 2 ? urlParts[0] : 'www';
const siteName = subdomain === 'www' || subdomain === 'wyattsnotes' ? "Wyatt's Notes" : `${subdomain.charAt(0).toUpperCase() + subdomain.slice(1)} | Wyatt's Notes`;

// Generate WebSite schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteTitle,
  description: 'Free, rigorous study notes for IB, A-Level, GCSE, AP, DSE, university STEM, and programming.',
  url: site,
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://search.wyattau.com/api/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
}

// Generate Article schema for content pages
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: description,
  author: {
    '@type': 'Person',
    name: 'Wyatt',
    url: 'https://wyattau.com',
  },
  publisher: {
    '@type': 'Organization',
    name: "Wyatt's Notes",
    url: 'https://wyattau.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://wyattau.com/img/logo.png',
    },
  },
  url: pageUrl,
  datePublished: datePublished,
  dateModified: dateModified,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
}

// Generate Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://wyattau.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: siteName,
      item: `https://${new URL(pageUrl).hostname}`,
    },
  ],
}
---

<!-- Page speed: preconnect to external origins -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://search.wyattau.com" crossorigin />

<!-- Page speed: DNS prefetch for subdomains -->
<link rel="dns-prefetch" href="https://dse.wyattau.com" />
<link rel="dns-prefetch" href="https://ib.wyattau.com" />
<link rel="dns-prefetch" href="https://alevel.wyattau.com" />
<link rel="dns-prefetch" href="https://gcse.wyattau.com" />
<link rel="dns-prefetch" href="https://ap.wyattau.com" />
<link rel="dns-prefetch" href="https://cpp.wyattau.com" />
<link rel="dns-prefetch" href="https://python.wyattau.com" />
<link rel="dns-prefetch" href="https://rust.wyattau.com" />
<link rel="dns-prefetch" href="https://mathematics.wyattau.com" />
<link rel="dns-prefetch" href="https://physics.wyattau.com" />

<!-- Page speed: preload critical assets -->
<link rel="modulepreload" href="/reader.js" />
<link rel="modulepreload" href="/cross-site-search.js" />
<link rel="modulepreload" href="/page-search.js" />
<link rel="modulepreload" href="/mermaid-render.js" />

<script>
  (function() {
    try {
      const saved = localStorage.getItem('wn-theme');
      if (saved && ['dark','light','sepia','contrast','nord','dracula','monokai','ayu-mirage','solarized','papercolor'].includes(saved)) {
        document.documentElement.setAttribute('data-theme', saved);
      }
      const fs = localStorage.getItem('wn-font-size');
      if (fs) document.documentElement.style.setProperty('--wn-font-size-scale', fs);
      const lh = localStorage.getItem('wn-line-height');
      if (lh) document.documentElement.style.setProperty('--wn-line-height', lh);
      const cw = localStorage.getItem('wn-content-width');
      if (cw) document.documentElement.style.setProperty('--wn-content-width', cw);
      const ff = localStorage.getItem('wn-font-family');
      if (ff === 'serif') document.documentElement.style.setProperty('--wn-font-body', '"Merriweather", Georgia, serif');
      else if (ff === 'mono') document.documentElement.style.setProperty('--wn-font-body', '"JetBrains Mono", "Fira Code", monospace');
      const j = localStorage.getItem('wn-justify');
      if (j) document.documentElement.setAttribute('data-justify', j);
      const rm = localStorage.getItem('wn-reduce-motion');
      if (rm) document.documentElement.setAttribute('data-reduce-motion', rm);
    } catch(e) {}
  })();
</script>

<!-- SEO Meta Tags -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<link rel="canonical" href={pageUrl} />

<!-- Hreflang for i18n -->
<link rel="alternate" hreflang="en" href={pageUrl} />
<link rel="alternate" hreflang="x-default" href={pageUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="article" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={`${new URL(pageUrl).origin}/img/social-card.svg`} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@wyattau" />
<meta name="twitter:creator" content="@wyattau" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${new URL(pageUrl).origin}/img/social-card.svg`} />

<!-- Additional SEO Meta -->
<meta name="author" content="Wyatt" />
<meta name="generator" content={Astro.generator} />

<!-- Starlight head items (title, KaTeX CSS, analytics, font preloads, etc.) -->
{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script is:inline>
(function() {
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').then(function(reg) {
      // SW registered
      reg.addEventListener('updatefound', function() {
        var newSW = reg.installing
        newSW.addEventListener('statechange', function() {
          if (newSW.state === 'installed' && navigator.serviceWorker.controller) {
            // New SW available
            newSW.postMessage({ type: 'SKIP_WAITING' })
          }
        })
      })
    }).catch(function(err) {
      // SW registration failed
    })
    navigator.serviceWorker.addEventListener('controllerchange', function() {
      window.location.reload()
    })
  }
})()
</script>

<!-- Reading controls (floating settings, focus mode, progress, position memory) -->
<script src="/reader.js" defer></script>

<!-- Site navigator: inject Sites button into Starlight header -->
<script is:inline>
(function(){
  function injectSitesButton(){
    var search = document.querySelector('#custom-search') || document.querySelector('.right-group')
    if(!search || !search.parentNode) return
    var btn = document.createElement('button')
    btn.className = 'site-nav-btn'
    btn.id = 'site-nav-trigger'
    btn.setAttribute('aria-label','Browse all sites')
    btn.setAttribute('title','Browse all sites')
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg><span>Sites</span>'
    search.parentNode.insertBefore(btn, search)
    btn.addEventListener('click', function(e){
      e.stopPropagation()
      var ov = document.getElementById('site-nav-overlay')
      if(!ov) ov = buildOverlay()
      ov.setAttribute('aria-hidden','false')
      document.body.classList.add('site-nav-open')
    })
  }
  function buildOverlay(){
    var SITES={'Exam Boards':[{n:'DSE',u:'https://dse.wyattau.com'},{n:'IB',u:'https://ib.wyattau.com'},{n:'A-Level',u:'https://alevel.wyattau.com'},{n:'GCSE',u:'https://gcse.wyattau.com'},{n:'AP',u:'https://ap.wyattau.com'},{n:'Highers',u:'https://highers.wyattau.com'},{n:'Leaving Cert',u:'https://leaving-cert.wyattau.com'},{n:'CBSE',u:'https://cbse.wyattau.com'},{n:'Gaokao',u:'https://gaokao.wyattau.com'},{n:'HSC',u:'https://hsc.wyattau.com'},{n:'SAT',u:'https://sat.wyattau.com'}],'Computer Science':[{n:'C++',u:'https://cpp.wyattau.com'},{n:'Java',u:'https://java.wyattau.com'},{n:'Python',u:'https://python.wyattau.com'},{n:'Rust',u:'https://rust.wyattau.com'},{n:'Go',u:'https://go.wyattau.com'},{n:'Kotlin',u:'https://kotlin.wyattau.com'},{n:'TypeScript',u:'https://typescript.wyattau.com'},{n:'Dart',u:'https://dart.wyattau.com'},{n:'Swift',u:'https://swift.wyattau.com'},{n:'Ruby',u:'https://ruby.wyattau.com'},{n:'Haskell',u:'https://haskell.wyattau.com'},{n:'Elixir',u:'https://elixir.wyattau.com'},{n:'Languages',u:'https://languages.wyattau.com'},{n:'Tools',u:'https://tools.wyattau.com'}],'Further Studies':[{n:'Mathematics',u:'https://mathematics.wyattau.com'},{n:'Physics',u:'https://physics.wyattau.com'},{n:'Chemistry',u:'https://chemistry.wyattau.com'},{n:'CS Theory',u:'https://computer-science.wyattau.com'},{n:'Admissions',u:'https://admissions.wyattau.com'}],'Infrastructure':[{n:'Networking',u:'https://networking.wyattau.com'},{n:'Linux',u:'https://linux.wyattau.com'},{n:'Security',u:'https://security.wyattau.com'},{n:'Databases',u:'https://databases.wyattau.com'},{n:'TrueNAS',u:'https://truenas.wyattau.com'},{n:'Tuning',u:'https://tuning.wyattau.com'},{n:'Licensing',u:'https://licensing.wyattau.com'},{n:'ML',u:'https://machine-learning.wyattau.com'}]}
    var cats=Object.keys(SITES)
    var el=document.createElement('div')
    el.id='site-nav-overlay'
    el.setAttribute('aria-hidden','true')
    el.innerHTML='<div class="site-nav-backdrop"></div><div class="site-nav-panel" role="dialog" aria-label="Site navigator"><div class="site-nav-header"><h2>All Sites</h2><button class="site-nav-close" aria-label="Close"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button></div><div class="site-nav-body">'+cats.map(function(c){return '<div class="site-nav-category"><div class="site-nav-cat-header"><span>'+c+'</span></div><div class="site-nav-grid">'+SITES[c].map(function(s){return '<a href="'+s.u+'" class="site-nav-card" target="_blank" rel="noopener"><strong>'+s.n+'</strong></a>'}).join('')+'</div></div>'}).join('')+'</div></div>'
    document.body.appendChild(el)
    el.querySelector('.site-nav-close').addEventListener('click',function(){el.setAttribute('aria-hidden','true');document.body.classList.remove('site-nav-open')})
    el.querySelector('.site-nav-backdrop').addEventListener('click',function(){el.setAttribute('aria-hidden','true');document.body.classList.remove('site-nav-open')})
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&el.getAttribute('aria-hidden')==='false'){el.setAttribute('aria-hidden','true');document.body.classList.remove('site-nav-open')}})
    return el
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',injectSitesButton)}else{injectSitesButton()}
})()
</script>

<!-- Cross-site search (injected into nav header) -->
<script src="/cross-site-search.js" defer></script>
<script src="/page-search.js" defer></script>

<!-- Mermaid: load library from CDN, then render diagrams -->
<script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script src="/mermaid-render.js" defer></script>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<ClientRouter />
