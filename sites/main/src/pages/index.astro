<Layout 
  title="Starlight Sites"
  description="Undergraduate and advanced study notes in mathematics, physics, computer science, and engineering."
>
  <section class="hero">
    <h1>Study notes<br><span>in mathematics, physics,<br>computer science, and engineering</span></h1>
    <p>IB, A-Level, GCSE, AP, DSE, university STEM, programming languages, and infrastructure reference.</p>
    <div class="hero-search">
      <svg class="hero-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="text" class="hero-search-input" placeholder="Search all subjects..." aria-label="Search all subjects" id="hero-search-input">
      <kbd class="hero-search-kbd">/</kbd>
    </div>
    <div class="hero-search-results" id="hero-search-results"></div>
  </section>

  <!-- Featured: Double pendulum + Fourier series -->
  <section class="featured-demos">
    <div class="featured-demo-card">
      <h2>Fourier Series</h2>
      <p>Approximating a square wave by summing sine waves. Drag the slider.</p>
      <div class="featured-demo-canvas">
        <canvas id="hero-fourier-canvas" width="280" height="200"></canvas>
      </div>
      <div class="featured-demo-controls" id="fourier-controls">
        <span>Terms:</span>
        <input type="range" min="1" max="50" value="10" id="fourier-slider">
        <span id="fourier-label">10</span>
      </div>
    </div>
    <div class="featured-demo-card">
      <h2>Sine Wave</h2>
      <p>Reference waveform rendered on canvas.</p>
      <div class="featured-demo-canvas">
        <canvas id="hero-sine-canvas" width="280" height="200"></canvas>
      </div>
    </div>
    <div class="featured-demo-card">
      <h2>Lissajous Curve</h2>
      <p>Harmonic motion visualization. Interactive parameters.</p>
      <div class="featured-demo-canvas">
        <canvas id="hero-lissajous-canvas" width="280" height="200"></canvas>
      </div>
      <div class="featured-demo-controls" id="lissajous-controls">
        <span>a/b:</span>
        <input type="range" min="1" max="7" value="3" id="lissajous-a">
        <span>:</span>
        <input type="range" min="1" max="7" value="2" id="lissajous-b">
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      // --- Search ---
      var searchInput = document.getElementById('hero-search-input');
      var searchResults = document.getElementById('hero-search-results');
      if (searchInput) {
        var timer = null;
        searchInput.addEventListener('input', function() {
          clearTimeout(timer);
          var q = searchInput.value.trim();
          if (q.length < 2) { searchResults.classList.remove('active'); return; }
          timer = setTimeout(function() {
            searchResults.innerHTML = '<div style="padding:0.5rem;color:#94a3b8;font-size:0.85rem">Searching...</div>';
            searchResults.classList.add('active');
            fetch('https://search.wyattau.com/api/search?q=' + encodeURIComponent(q) + '&limit=8')
              .then(function(r) { return r.json(); })
              .then(function(data) {
                if (!data.results || data.results.length === 0) {
                  searchResults.innerHTML = '<div style="padding:0.5rem;color:#94a3b8;font-size:0.85rem">No results found</div>';
                  return;
                }
                searchResults.innerHTML = data.results.map(function(r) {
                  var u = new URL(r.url);
                  return '<a class="hero-search-result" href="' + r.url + '" target="_blank"><span class="hero-search-result-site" style="background:' + r.siteColor + '20;color:' + r.siteColor + '">' + r.siteName + '</span><span class="hero-search-result-title">' + r.title + '</span></a>';
                }).join('');
              }).catch(function() {
                searchResults.innerHTML = '<div style="padding:0.5rem;color:#94a3b8;font-size:0.85rem">Search unavailable</div>';
              });
          }, 300);
        });
        searchInput.addEventListener('focus', function() {
          if (searchInput.value.trim().length >= 2) searchResults.classList.add('active');
        });
        document.addEventListener('click', function(e) {
          if (!e.target.closest('.hero-search')) searchResults.classList.remove('active');
        });
        searchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') searchResults.classList.remove('active');
        });
      }
    })();
  </script>

