          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a href="https://github.com/WyattAu/starlight-sites" class="btn btn-secondary">
        View on GitHub
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Featured: WASM interactive demo -->
  <section class="featured-demo">
    <div class="featured-demo-inner">
      <h2>Fourier Series — live visualization</h2>
      <p>Interactive canvas rendering compiled from Rust to WebAssembly. Adjust the slider to see the approximation converge.</p>
      <div class="featured-demo-embed">
        <canvas id="hero-fourier-demo" width="600" height="350"></canvas>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var canvas = document.getElementById('hero-fourier-demo');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var terms = 10;
      function draw() {
        var w = canvas.width, h = canvas.height;
        var cx = w/2, cy = h/2, scale = h*0.38;
        ctx.clearRect(0,0,w,h);
        ctx.strokeStyle = 'rgba(150,150,200,0.2)';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(0,cy); ctx.lineTo(w,cy); ctx.stroke();
        ctx.strokeStyle = '#ff6b35';
        ctx.lineWidth = 2;
        ctx.beginPath();
        for (var i=0; i<=w; i++) {
          var x = i/w;
          var y=0.0;
          for (var n=1; n<=terms; n++) {
            var k=2*n-1;
            y += (1/k)*Math.sin(k*x*2*Math.PI);
          }
          y *= 4/Math.PI;
          var px = cx+(x-0.5)*w*0.88;
          var py = cy - y*scale;
          if (i===0) ctx.moveTo(px,py); else ctx.lineTo(px,py);
        }
        ctx.stroke();
      }
      draw();
      // Add slider
      var slider = document.createElement('input');
      slider.type = 'range'; slider.min=1; slider.max=50; slider.value=10;
      slider.style.cssText = 'width:200px;margin-top:10px;accent-color:#ff6b35;display:block;margin-left:auto;margin-right:auto';
      canvas.parentNode.appendChild(slider);
      var label = document.createElement('div');
      label.style.cssText = 'font-size:0.8rem;color:#94a3b8;text-align:center;margin-top:4px';
      label.textContent = 'Terms: 10';
      canvas.parentNode.appendChild(label);
      slider.addEventListener('input', function() {
        terms = parseInt(this.value);
        label.textContent = 'Terms: ' + terms;
        draw();
      });
    })();
  </script>
    <div class="stat">
