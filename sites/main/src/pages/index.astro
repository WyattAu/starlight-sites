---
import Layout from '../layouts/Layout.astro'

const examBoards = [
  { name: 'DSE', meta: '161 pages · 53 topics', url: 'https://dse.wyattau.com/' },
  { name: 'IB', meta: '304 pages · 73 topics', url: 'https://ib.wyattau.com/' },
  { name: 'A-Level', meta: '366 pages · 71 topics', url: 'https://alevel.wyattau.com/' },
  { name: 'GCSE', meta: '80 pages · 41 topics', url: 'https://gcse.wyattau.com/' },
  { name: 'AP', meta: '77 pages · 51 topics', url: 'https://ap.wyattau.com/' },
  { name: 'Highers', meta: '47 pages · 35 topics', url: 'https://highers.wyattau.com/' },
  { name: 'Leaving Cert', meta: '47 pages · 35 topics', url: 'https://leaving-cert.wyattau.com/' },
  { name: 'CBSE', meta: '11 pages', url: 'https://cbse.wyattau.com/' },
  { name: 'Gaokao', meta: '3 pages', url: 'https://gaokao.wyattau.com/' },
  { name: 'HSC', meta: '3 pages', url: 'https://hsc.wyattau.com/' },
  { name: 'SAT', meta: '11 pages', url: 'https://sat.wyattau.com/' },
]
const computerScience = [
  { name: 'C++', meta: '130 pages · 34 topics', url: 'https://cpp.wyattau.com/' },
  { name: 'Language Hub', meta: '190 pages · 78 topics', url: 'https://languages.wyattau.com/' },
  { name: 'Tools', meta: '65 pages · 27 topics', url: 'https://tools.wyattau.com/' },
  { name: 'Java', meta: '29 pages · 13 topics', url: 'https://java.wyattau.com/' },
  { name: 'Python', meta: '30 pages · 7 topics', url: 'https://python.wyattau.com/' },
  { name: 'Rust', meta: '21 pages · 7 topics', url: 'https://rust.wyattau.com/' },
  { name: 'Go', meta: '24 pages · 5 topics', url: 'https://go.wyattau.com/' },
  { name: 'Kotlin', meta: '19 pages · 3 topics', url: 'https://kotlin.wyattau.com/' },
  { name: 'TypeScript', meta: '14 pages', url: 'https://typescript.wyattau.com/' },
  { name: 'Dart', meta: '25 pages · 10 topics', url: 'https://dart.wyattau.com/' },
  { name: 'Swift', meta: '9 pages · 5 topics', url: 'https://swift.wyattau.com/' },
  { name: 'Ruby', meta: '10 pages · 6 topics', url: 'https://ruby.wyattau.com/' },
  { name: 'Haskell', meta: '10 pages · 6 topics', url: 'https://haskell.wyattau.com/' },
  { name: 'Elixir', meta: '9 pages · 5 topics', url: 'https://elixir.wyattau.com/' },
]
const furtherStudies = [
  { name: 'Mathematics', meta: '160 pages · 13 topics', url: 'https://mathematics.wyattau.com/' },
  { name: 'Physics', meta: '137 pages · 7 topics', url: 'https://physics.wyattau.com/' },
  { name: 'Chemistry', meta: '30 pages · 3 topics', url: 'https://chemistry.wyattau.com/' },
  { name: 'CS Theory', meta: '115 pages · 9 topics', url: 'https://computer-science.wyattau.com/' },
  { name: 'Admissions', meta: '9 pages', url: 'https://admissions.wyattau.com/' },
]
const infrastructure = [
  { name: 'Networking', meta: '22 pages · 10 topics', url: 'https://networking.wyattau.com/' },
  { name: 'Linux', meta: '20 pages · 7 topics', url: 'https://linux.wyattau.com/' },
  { name: 'Security', meta: '18 pages · 9 topics', url: 'https://security.wyattau.com/' },
  { name: 'Databases', meta: '16 pages · 6 topics', url: 'https://databases.wyattau.com/' },
  { name: 'TrueNAS', meta: '12 pages · 7 topics', url: 'https://truenas.wyattau.com/' },
  { name: 'Tuning', meta: '10 pages · 6 topics', url: 'https://tuning.wyattau.com/' },
  { name: 'Licensing', meta: '2 pages', url: 'https://licensing.wyattau.com/' },
  { name: 'Machine Learning', meta: '2 pages', url: 'https://machine-learning.wyattau.com/' },
]

const groups = [
  { label: 'Exam Boards', image: 'exam-prep', sites: examBoards },
  { label: 'Computer Science', image: 'computer-science', sites: computerScience },
  { label: 'Further Studies', image: 'mathematics', sites: furtherStudies },
  { label: 'Infrastructure', image: 'infrastructure', sites: infrastructure },
]
const totalSites = groups.reduce((n, g) => n + g.sites.length, 0)
let rowNumber = 0
const dirSubjects = [
  {
    title: 'Mathematics',
    links: [
      { text: 'University Mathematics', url: 'https://mathematics.wyattau.com/' },
      { text: 'IB Mathematics', url: 'https://ib.wyattau.com/docs/ib/maths/' },
      { text: 'A-Level Mathematics', url: 'https://alevel.wyattau.com/docs/alevel/maths/' },
      { text: 'DSE Mathematics', url: 'https://dse.wyattau.com/docs/dse/maths/' },
    ],
  },
  {
    title: 'Physics',
    links: [
      { text: 'University Physics', url: 'https://physics.wyattau.com/' },
      { text: 'IB Physics', url: 'https://ib.wyattau.com/docs/ib/physics/' },
      { text: 'A-Level Physics', url: 'https://alevel.wyattau.com/docs/alevel/physics/' },
      { text: 'DSE Physics', url: 'https://dse.wyattau.com/docs/dse/physics/' },
    ],
  },
  {
    title: 'Computer Science',
    links: [
      { text: 'CS Theory', url: 'https://computer-science.wyattau.com/' },
      { text: 'C++ Programming', url: 'https://cpp.wyattau.com/' },
      { text: 'Python Programming', url: 'https://python.wyattau.com/' },
      { text: 'Java Programming', url: 'https://java.wyattau.com/' },
    ],
  },
  {
    title: 'Chemistry',
    links: [
      { text: 'University Chemistry', url: 'https://chemistry.wyattau.com/' },
      { text: 'IB Chemistry', url: 'https://ib.wyattau.com/docs/ib/chemistry/' },
      { text: 'A-Level Chemistry', url: 'https://alevel.wyattau.com/docs/alevel/chemistry/' },
      { text: 'DSE Chemistry', url: 'https://dse.wyattau.com/docs/dse/chemistry/' },
    ],
  },
]
---

<Layout
  title="Wyatt's Notes | Free Study Notes for IB, A-Level, GCSE, AP, DSE, University STEM"
  description="Free, rigorous study notes for IB, A-Level, GCSE, AP, DSE, university STEM, and programming. 2,860+ pages across 40+ subjects with worked examples, common mistakes, and exam-style problems."
>
  <div class="ea-progress" id="ea-progress"></div>

  <main>
    <section class="ea-hero">
      <div class="ea-hero-media" aria-hidden="true">
        <picture>
          <source srcset="/img/hero/library.avif" type="image/avif" />
          <source srcset="/img/hero/library.webp" type="image/webp" />
          <img
            src="/img/hero/library.jpg"
            alt=""
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="ea-hero-scrim" aria-hidden="true"></div>
      <div class="ea-hero-content">
        <p class="ea-kicker reveal">Wyatt&rsquo;s Notes &mdash; Open Study Library</p>
        <h1>
          <span class="reveal-line"><span>Study notes worth</span></span>
          <span class="reveal-line"><span><em class="ea-accent-word">coming back</em> for.</span></span>
        </h1>
        <p class="ea-hero-sub reveal">
          Rigorous, exam-aligned notes for IB, A-Level, GCSE, AP, DSE, university STEM, and
          programming &mdash; with worked examples, common mistakes, and practice problems.
        </p>
        <div class="ea-search reveal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          <input
            type="text"
            id="ea-search-input"
            class="ea-search-input"
            placeholder="Search all subjects..."
            aria-label="Search all subjects"
            autocomplete="off"
          />
          <kbd>/</kbd>
        </div>
        <div class="ea-search-results" id="ea-search-results"></div>
        <p class="ea-search-hint">Free, forever. No accounts, no paywalls.</p>
      </div>
    </section>

    <section class="ea-trust" aria-label="Library statistics">
      <div class="ea-trust-inner">
        <div class="ea-trust-item reveal">
          <span class="ea-trust-value">2,860+</span>
          <span class="ea-trust-label">Pages</span>
        </div>
        <div class="ea-trust-item reveal">
          <span class="ea-trust-value">{totalSites}</span>
          <span class="ea-trust-label">Subject Sites</span>
        </div>
        <div class="ea-trust-item reveal">
          <span class="ea-trust-value">15+</span>
          <span class="ea-trust-label">Languages</span>
        </div>
        <div class="ea-trust-item reveal">
          <span class="ea-trust-value">100%</span>
          <span class="ea-trust-label">Free Access</span>
        </div>
      </div>
    </section>

    <section class="ea-section" aria-label="Subject index">
      <div class="ea-section-head reveal">
        <span class="ea-section-num" aria-hidden="true">01</span>
        <h2 class="ea-section-title">The Library</h2>
      </div>
      <div class="ea-index">
        {
          groups.map((group) => (
            <div class="ea-group">
              <div class="ea-section-head reveal" style="margin-bottom: 1rem;">
                <h3 class="ea-section-title" style="color: var(--wn-text-dim);">{group.label}</h3>
              </div>
              {group.sites.map((site) => {
                rowNumber += 1
                const num = String(rowNumber).padStart(2, '0')
                return (
                  <a class="ea-row reveal" href={site.url} data-image={`/img/subjects/${group.image}.webp`}>
                    <span class="ea-row-num">{num}</span>
                    <span class="ea-row-name">
                      {site.name}
                      <span class="ea-row-leader" aria-hidden="true" />
                    </span>
                    <span class="ea-row-meta">{site.meta}</span>
                  </a>
                )
              })}
            </div>
          ))
        }
      </div>
    </section>

    <section class="ea-section" aria-label="About these notes">
      <div class="ea-section-head reveal">
        <span class="ea-section-num" aria-hidden="true">02</span>
        <h2 class="ea-section-title">Why These Notes</h2>
      </div>
      <div class="ea-mission">
        <div class="ea-mission-media reveal-img">
          <picture>
            <source srcset="/img/subjects/books.avif" type="image/avif" />
            <img
              src="/img/subjects/books.webp"
              alt="Library shelves lit by warm hanging lamps"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="ea-mission-copy reveal">
          <h2>Written like a <em>textbook</em>, priced like nothing.</h2>
          <p>
            Every topic is built the same way: formal definitions alongside intuition, worked
            examples with complete solutions, and a common-mistakes section drawn from real
            examiner reports.
          </p>
          <p>
            Notes are aligned to each board&rsquo;s specification &mdash; AQA, Edexcel, OCR, CIE, IB,
            HKEAA &mdash; so what you revise is what gets examined.
          </p>
          <div class="ea-mission-rule" aria-hidden="true"></div>
          <p>
            No registration. No advertising. No premium tier. The entire library is open and
            free, sustained by one educator and its readers.
          </p>
        </div>
      </div>
    </section>

    <section class="ea-quote" aria-label="Student testimonial">
      <blockquote class="reveal">
        The best free study notes I&rsquo;ve found online. The worked examples and common mistakes
        sections saved me hours of exam preparation. I got a 43 in IB Maths thanks to these
        notes.
      </blockquote>
      <cite>Priya K. &mdash; IB Student, Hong Kong</cite>
    </section>

    <section class="ea-directory" aria-label="Full site directory">
      <div class="ea-directory-inner">
        <h2 class="reveal">The full catalogue.</h2>
        <p class="ea-directory-sub reveal">
          Every site in the network, cross-referenced and searchable.
        </p>
        <div class="ea-dir-grid">
          {
            dirSubjects.map((subject) => (
              <div class="ea-dir-col reveal">
                <h3>{subject.title}</h3>
                <ul>
                  {subject.links.map((link) => (
                    <li>
                      <a href={link.url}>{link.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="ea-dir-cta reveal">
          <p>Browse study guides, cheat sheets, and revision checklists.</p>
          <a href="/study-guides" class="ea-btn"><span>Browse Study Guides</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <div class="footer-text">2026 Wyatt Au. Licensed under AGPLv3.</div>
      <div class="footer-links">
        <a href="https://github.com/WyattAu/starlight-sites" rel="noopener noreferrer" target="_blank">GitHub</a>
        <a href="https://search.wyattau.com/" rel="noopener noreferrer" target="_blank">Search</a>
        <a
          href="https://github.com/WyattAu/starlight-sites/blob/main/LICENSE.md"
          rel="noopener noreferrer"
          target="_blank">License</a
        >
      </div>
    </div>
  </footer>

  <figure class="ea-follow" id="ea-follow" aria-hidden="true">
    {
      groups.map((group) => (
        <img
          src={`/img/subjects/${group.image}.webp`}
          alt=""
          loading="lazy"
          decoding="async"
          data-group={group.image}
        />
      ))
    }
  </figure>

  <script>
    ;(() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      // Scroll progress
      const progress = document.getElementById('ea-progress')
      const nav = document.querySelector('nav')
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight
        if (progress) progress.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%'
        if (nav) nav.classList.toggle('nav-solid', window.scrollY > 80)
      }
      document.addEventListener('scroll', onScroll, { passive: true })
      onScroll()

      // Reveals
      const targets = document.querySelectorAll('.reveal, .reveal-line, .reveal-img')
      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('revealed'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed')
                io.unobserve(entry.target)
              }
            })
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        )
        targets.forEach((el) => io.observe(el))
      }

      // Cursor-following subject photo
      const follow = document.getElementById('ea-follow')
      if (follow && !reduced && window.matchMedia('(hover: hover)').matches) {
        const imgs = follow.querySelectorAll('img')
        let mx = 0
        let my = 0
        let cx = 0
        let cy = 0
        let raf = null
        const tick = () => {
          cx += (mx - cx) * 0.12
          cy += (my - cy) * 0.12
          follow.style.left = cx + 'px'
          follow.style.top = cy + 'px'
          raf = Math.abs(mx - cx) > 0.5 || Math.abs(my - cy) > 0.5 ? requestAnimationFrame(tick) : null
        }
        document.querySelectorAll('.ea-row').forEach((row) => {
          row.addEventListener('mouseenter', (e) => {
            mx = e.clientX
            my = e.clientY
            cx = mx
            cy = my
            const key = row.getAttribute('data-image') || ''
            imgs.forEach((img) => {
              const match = key.indexOf(img.getAttribute('data-group') || '___') !== -1
              img.classList.toggle('on', match)
            })
            follow.classList.add('on')
            if (!raf) raf = requestAnimationFrame(tick)
          })
          row.addEventListener('mousemove', (e) => {
            mx = e.clientX
            my = e.clientY
            if (!raf) raf = requestAnimationFrame(tick)
          })
        })
        document.addEventListener('mouseleave', () => follow.classList.remove('on'))
      }

      // Hero search
      const input = document.getElementById('ea-search-input')
      const results = document.getElementById('ea-search-results')
      if (input && results) {
        let timer = null
        input.addEventListener('input', () => {
          clearTimeout(timer)
          const q = input.value.trim()
          if (q.length < 2) {
            results.classList.remove('active')
            return
          }
          timer = setTimeout(() => {
            results.textContent = 'Searching...'
            results.classList.add('active')
            fetch('https://search.wyattau.com/api/search?q=' + encodeURIComponent(q) + '&limit=8')
              .then((r) => r.json())
              .then((data) => {
                if (!data.results || data.results.length === 0) {
                  results.textContent = 'No results found'
                  return
                }
                results.textContent = ''
                data.results.forEach((r) => {
                  const a = document.createElement('a')
                  a.href = r.url
                  a.target = '_blank'
                  a.rel = 'noopener noreferrer'
                  const site = document.createElement('span')
                  site.className = 'ea-result-site'
                  site.style.background = r.siteColor + '20'
                  site.style.color = r.siteColor
                  site.textContent = r.siteName
                  const title = document.createElement('span')
                  title.textContent = r.title
                  a.append(site, title)
                  results.append(a)
                })
              })
              .catch(() => {
                results.textContent = 'Search unavailable'
              })
          }, 300)
        })
        input.addEventListener('focus', () => {
          if (input.value.trim().length >= 2) results.classList.add('active')
        })
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ea-search')) results.classList.remove('active')
        })
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') results.classList.remove('active')
        })
        document.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== input) {
            e.preventDefault()
            input.focus()
          }
        })
      }
    })()
  </script>
</Layout>
