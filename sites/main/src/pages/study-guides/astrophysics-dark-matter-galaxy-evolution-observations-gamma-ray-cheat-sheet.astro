import Layout from '../../layouts/Layout.astro'
---

<Layout 
  title="Dark Matter Galaxy Evolution Observations Gamma-ray Cheat Sheet | Free AGN, GRBs, Cosmic Rays"
  description="Complete dark matter galaxy evolution observations gamma-ray cheat sheet with AGN, GRBs, and cosmic rays. Free download for physics students."
>
  <section class="hero">
    <h1>Dark Matter Galaxy Evolution Observations Gamma-ray<br><span>Cheat Sheet</span></h1>
    <p>AGN, GRBs, and cosmic rays. From high-energy emission to dark matter annihilation.</p>
  </section>

  <section>
    <h2>Gamma-ray Emission</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Sources</h3>
        <pre><code>AGN jets: blazars, radio galaxies
Gamma-ray bursts: most luminous events
Pulsars: rotating neutron stars
Supernova remnants: shocked cosmic rays
Dark matter annihilation: hypothetical</code></pre>
      </div>
    </div>
  </section>

  <section>
    <h2>AGN</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Gamma-ray Properties</h3>
        <pre><code>Blazars: jet pointed at Earth
Luminosity: 10⁴⁴-10⁴⁹ erg/s
Spectrum: power law with cutoff
Variability: minutes to years
Fermi-LAT: all-sky survey</code></pre>
      </div>
    </div>
  </section>

  <section>
    <h2>Gamma-ray Bursts</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Properties</h3>
        <pre><code>Duration: 0.01-1000 s
Luminosity: 10⁵⁰-10⁵⁴ erg/s (isotropic)
Short GRBs: neutron star mergers
Long GRBs: core-collapse supernovae
Afterglow: multi-wavelength</code></pre>
      </div>
    </div>
  </section>

  <section>
    <h2>Dark Matter Annihilation</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Signatures</h3>
        <pre><code>Gamma-ray lines: monochromatic emission
Continuum: from decay of annihilation products
Galactic center: excess emission claim
Dwarf spheroidals: clean targets
Fermi-LAT: constraints on WIMP cross section</code></pre>
      </div>
    </div>
  </section>

  <section>
    <h2>Download</h2>
    <p>Print this page or save as PDF for quick reference.</p>
    <p><strong>Tip:</strong> Use Ctrl+P (Cmd+P on Mac) to print or save as PDF.</p>
  </section>
</Layout>
