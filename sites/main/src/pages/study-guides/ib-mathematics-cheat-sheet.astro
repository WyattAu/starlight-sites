---
import Layout from '../../layouts/Layout.astro'
---

<Layout 
  title="IB Mathematics Cheat Sheet | Free Formulas & Examples"
  description="Complete IB Mathematics cheat sheet with 50+ essential formulas for HL and SL. Covers algebra, calculus, statistics, and more. Free download."
>
  <section class="hero">
    <h1>IB Mathematics<br><span>Cheat Sheet</span></h1>
    <p>50+ essential formulas for HL and SL. Covers all core topics with worked examples.</p>
  </section>

  <section>
    <h2>Algebra</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Quadratic Formula</h3>
        <p class="formula">$$x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}$$</p>
        <p>For $ax^2 + bx + c = 0$</p>
      </div>
      <div class="formula-card">
        <h3>Sum of Geometric Series</h3>
        <p class="formula">$$S_n = \frac{a(1-r^n)}{1-r}$$</p>
        <p>For $r \neq 1$</p>
      </div>
      <div class="formula-card">
        <h3>Sum to Infinity</h3>
        <p class="formula">$$S_\infty = \frac{a}{1-r}$$</p>
        <p>For $|r| < 1$</p>
      </div>
    </div>
  </section>

  <section>
    <h2>Calculus</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Power Rule</h3>
        <p class="formula">$$\frac{d}{dx}x^n = nx^{n-1}$$</p>
      </div>
      <div class="formula-card">
        <h3>Chain Rule</h3>
        <p class="formula">$$\frac{d}{dx}f(g(x)) = f'(g(x)) \cdot g'(x)$$</p>
      </div>
      <div class="formula-card">
        <h3>Integration by Parts</h3>
        <p class="formula">$$\int u \, dv = uv - \int v \, du$$</p>
      </div>
    </div>
  </section>

  <section>
    <h2>Statistics</h2>
    <div class="formula-grid">
      <div class="formula-card">
        <h3>Mean</h3>
        <p class="formula">$$\bar{x} = \frac{\sum x_i}{n}$$</p>
      </div>
      <div class="formula-card">
        <h3>Standard Deviation</h3>
        <p class="formula">$$\sigma = \sqrt{\frac{\sum(x_i - \bar{x})^2}{n}}$$</p>
      </div>
      <div class="formula-card">
        <h3>Normal Distribution</h3>
        <p class="formula">$$f(x) = \frac{1}{\sigma\sqrt{2\pi}} e^{-\frac{1}{2}\left(\frac{x-\mu}{\sigma}\right)^2}$$</p>
      </div>
    </div>
  </section>

  <section>
    <h2>Download</h2>
    <p>Print this page or save as PDF for quick reference during revision.</p>
    <p><strong>Tip:</strong> Use Ctrl+P (Cmd+P on Mac) to print or save as PDF.</p>
  </section>
</Layout>
