    </div>
    <div class="site-grid" data-cols="3">
      <a href="/study-guides/ib-exam-strategy" class="site-card">
        <h3>IB Exam Strategy Guide</h3>
        <span class="site-card-meta">Paper 1, 2, 3 & IA tips</span>
      </a>
      <a href="/study-guides/alevel-exam-technique" class="site-card">
