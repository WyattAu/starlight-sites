---
import Layout from '../../layouts/Layout.astro'
---

<Layout 
  title="Free Study Guides & Cheat Sheets | Wyatt's Notes"
  description="Download free study guides and cheat sheets for IB, A-Level, GCSE, AP, DSE, university STEM, and programming. Comprehensive revision materials with worked examples."
>
  <section class="hero">
    <h1>Free Study Guides<br><span>& Cheat Sheets</span></h1>
    <p>Comprehensive revision materials for all subjects. Download, print, and ace your exams.</p>
  </section>

  <section>
    <div class="section-header">
      <h2>Mathematics</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="/study-guides/ib-mathematics-cheat-sheet" class="site-card">
        <h3>IB Mathematics Cheat Sheet</h3>
        <span class="site-card-meta">HL & SL | 50+ formulas</span>
      </a>
      <a href="/study-guides/alevel-mathematics-formula-sheet" class="site-card">
        <h3>A-Level Mathematics Formula Sheet</h3>
        <span class="site-card-meta">Pure & Mechanics | 40+ formulas</span>
      </a>
      <a href="/study-guides/calculus-quick-reference" class="site-card">
        <h3>Calculus Quick Reference</h3>
        <span class="site-card-meta">Derivatives & Integrals | 30+ rules</span>
      </a>
      <a href="/study-guides/linear-algebra-cheat-sheet" class="site-card">
        <h3>Linear Algebra Cheat Sheet</h3>
        <span class="site-card-meta">Matrices & Vectors | 25+ operations</span>
      </a>
      <a href="/study-guides/probability-statistics-reference" class="site-card">
        <h3>Probability & Statistics Reference</h3>
        <span class="site-card-meta">Distributions & Tests | 20+ formulas</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>Physics</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="/study-guides/ib-physics-data-booklet-summary" class="site-card">
        <h3>IB Physics Data Booklet Summary</h3>
        <span class="site-card-meta">All constants & formulas</span>
      </a>
      <a href="/study-guides/alevel-physics-formula-sheet" class="site-card">
        <h3>A-Level Physics Formula Sheet</h3>
        <span class="site-card-meta">Mechanics, Waves, Fields | 40+ formulas</span>
      </a>
      <a href="/study-guides/mechanics-quick-reference" class="site-card">
        <h3>Mechanics Quick Reference</h3>
        <span class="site-card-meta">SUVAT, Forces, Energy | 20+ equations</span>
      </a>
      <a href="/study-guides/electromagnetism-cheat-sheet" class="site-card">
        <h3>Electromagnetism Cheat Sheet</h3>
        <span class="site-card-meta">Maxwell's Equations & Applications</span>
      </a>
      <a href="/study-guides/quantum-physics-summary" class="site-card">
        <h3>Quantum Physics Summary</h3>
        <span class="site-card-meta">Photoelectric, Schrodinger, Bohr</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>Chemistry</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="/study-guides/ib-chemistry-data-booklet-summary" class="site-card">
        <h3>IB Chemistry Data Booklet Summary</h3>
        <span class="site-card-meta">Periodic table & constants</span>
