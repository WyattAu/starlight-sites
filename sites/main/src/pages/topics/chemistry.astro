---
import Layout from '../../layouts/Layout.astro'
---

<Layout 
  title="Chemistry Study Notes | Free IB, A-Level, GCSE, AP, DSE Chemistry Resources"
  description="Comprehensive chemistry study notes covering university-level chemistry, IB Chemistry, A-Level Chemistry, GCSE Chemistry, AP Chemistry, DSE Chemistry, and more. Free worked examples and exam preparation."
>
  <section class="hero">
    <h1>Chemistry<br><span>Study Notes & Resources</span></h1>
    <p>From organic reactions to quantum chemistry. Free, rigorous notes with worked examples and common mistakes.</p>
  </section>

  <section>
    <div class="section-header">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <h2>University Chemistry</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="https://chemistry.wyattau.com/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Chemistry</h3>
        <span class="site-card-meta">30 pages · 3 topics</span>
      </a>
      <a href="https://chemistry.wyattau.com/docs/chemistry/1-physical-chemistry" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Physical Chemistry</h3>
        <span class="site-card-meta">Thermochemistry, Kinetics, Quantum</span>
      </a>
      <a href="https://chemistry.wyattau.com/docs/chemistry/2-organic-chemistry" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Organic Chemistry</h3>
        <span class="site-card-meta">Reactions, Mechanisms, Synthesis</span>
      </a>
      <a href="https://chemistry.wyattau.com/docs/chemistry/3-inorganic-chemistry" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Inorganic Chemistry</h3>
        <span class="site-card-meta">Transition Metals, Coordination</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
        </svg>
      </div>
      <h2>Exam Board Chemistry</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="https://ib.wyattau.com/docs/ib/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>IB Chemistry</h3>
        <span class="site-card-meta">HL & SL</span>
      </a>
      <a href="https://alevel.wyattau.com/docs/alevel/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>A-Level Chemistry</h3>
        <span class="site-card-meta">Physical, Organic, Inorganic</span>
      </a>
      <a href="https://gcse.wyattau.com/docs/gcse/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>GCSE Chemistry</h3>
        <span class="site-card-meta">Foundation & Higher Tier</span>
      </a>
      <a href="https://ap.wyattau.com/docs/ap/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>AP Chemistry</h3>
        <span class="site-card-meta">Atomic Structure, Bonding, Reactions</span>
      </a>
      <a href="https://dse.wyattau.com/docs/dse/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>DSE Chemistry</h3>
        <span class="site-card-meta">Compulsory & Extended Part</span>
      </a>
      <a href="https://highers.wyattau.com/docs/highers/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Scottish Highers Chemistry</h3>
        <span class="site-card-meta">General & Applied</span>
      </a>
      <a href="https://leaving-cert.wyattau.com/docs/leaving-cert/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Leaving Cert Chemistry</h3>
        <span class="site-card-meta">Higher & Ordinary Level</span>
      </a>
      <a href="https://cbse.wyattau.com/docs/cbse/chemistry/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>CBSE Chemistry</h3>
        <span class="site-card-meta">Class 11 & 12</span>
      </a>
    </div>
  </section>

