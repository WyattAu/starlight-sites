  </section>

  <section>
    <div class="section-header">
      <h2>Related Topics</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="/topics/physics" class="site-card">
        <h3>Physics</h3>
        <span class="site-card-meta">Physical chemistry and quantum mechanics</span>
      </a>
      <a href="/topics/mathematics" class="site-card">
        <h3>Mathematics</h3>
        <span class="site-card-meta">Mathematical tools for chemistry</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
