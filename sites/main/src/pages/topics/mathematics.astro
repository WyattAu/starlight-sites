---
import Layout from '../../layouts/Layout.astro'
---

<Layout 
  title="Mathematics Study Notes | Free IB, A-Level, GCSE, AP, DSE Math Resources"
  description="Comprehensive mathematics study notes covering university-level math, IB Mathematics, A-Level Maths, GCSE Maths, AP Calculus, DSE Mathematics, and more. Free worked examples and exam preparation."
>
  <section class="hero">
    <h1>Mathematics<br><span>Study Notes & Resources</span></h1>
    <p>From foundational algebra to advanced university mathematics. Free, rigorous notes with worked examples and common mistakes.</p>
  </section>

  <section>
    <div class="section-header">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <h2>University Mathematics</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="https://mathematics.wyattau.com/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Mathematics</h3>
        <span class="site-card-meta">160 pages · 13 topics</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/linear-algebra" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Linear Algebra</h3>
        <span class="site-card-meta">Matrices, Vector Spaces, Eigenvalues</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/real-analysis" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Real Analysis</h3>
        <span class="site-card-meta">Limits, Continuity, Metric Spaces</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/multivariable-calculus" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Multivariable Calculus</h3>
        <span class="site-card-meta">Partial Derivatives, Multiple Integrals</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/complex-analysis" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Complex Analysis</h3>
        <span class="site-card-meta">Analytic Functions, Contour Integration</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/abstract-algebra" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Abstract Algebra</h3>
        <span class="site-card-meta">Groups, Rings, Fields</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/number-theory" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Number Theory</h3>
        <span class="site-card-meta">Primes, Congruences, Diophantine Equations</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/probability-and-statistics" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Probability & Statistics</h3>
        <span class="site-card-meta">Distributions, Hypothesis Testing</span>
      </a>
      <a href="https://mathematics.wyattau.com/docs/mathematics/topology" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Topology</h3>
        <span class="site-card-meta">Topological Spaces, Compactness</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
        </svg>
      </div>
      <h2>Exam Board Mathematics</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="https://ib.wyattau.com/docs/ib/mathematics/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>IB Mathematics</h3>
        <span class="site-card-meta">HL & SL | AA & AI</span>
      </a>
      <a href="https://alevel.wyattau.com/docs/alevel/maths/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>A-Level Mathematics</h3>
        <span class="site-card-meta">Pure, Mechanics, Statistics</span>
      </a>
      <a href="https://gcse.wyattau.com/docs/gcse/maths/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>GCSE Mathematics</h3>
        <span class="site-card-meta">Foundation & Higher Tier</span>
      </a>
      <a href="https://ap.wyattau.com/docs/ap/calculus-ab/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>AP Calculus AB</h3>
        <span class="site-card-meta">Limits, Derivatives, Integrals</span>
      </a>
      <a href="https://ap.wyattau.com/docs/ap/calculus-bc/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>AP Calculus BC</h3>
        <span class="site-card-meta">Series, Parametric, Polar</span>
      </a>
      <a href="https://dse.wyattau.com/docs/dse/maths/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>DSE Mathematics</h3>
        <span class="site-card-meta">Compulsory & Extended Part</span>
      </a>
      <a href="https://highers.wyattau.com/docs/highers/maths/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Scottish Highers Maths</h3>
        <span class="site-card-meta">Applications, Mathematics</span>
      </a>
      <a href="https://leaving-cert.wyattau.com/docs/leaving-cert/maths/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>Leaving Cert Mathematics</h3>
        <span class="site-card-meta">Higher & Ordinary Level</span>
      </a>
      <a href="https://cbse.wyattau.com/docs/cbse/maths/" class="site-card" target="_blank" rel="noopener noreferrer">
        <h3>CBSE Mathematics</h3>
        <span class="site-card-meta">Class 11 & 12</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
        </svg>
      </div>
      <h2>Study Guides & Cheat Sheets</h2>
    </div>
    <div class="site-grid" data-cols="3">
      <a href="/study-guides/ib-mathematics-cheat-sheet" class="site-card">
        <h3>IB Mathematics Cheat Sheet</h3>
        <span class="site-card-meta">HL & SL | 50+ formulas</span>
      </a>
      <a href="/study-guides/alevel-mathematics-formula-sheet" class="site-card">
        <h3>A-Level Mathematics Formula Sheet</h3>
        <span class="site-card-meta">Pure & Mechanics | 40+ formulas</span>
      </a>
      <a href="/study-guides/calculus-quick-reference" class="site-card">
        <h3>Calculus Quick Reference</h3>
        <span class="site-card-meta">Derivatives & Integrals | 30+ rules</span>
      </a>
      <a href="/study-guides/linear-algebra-cheat-sheet" class="site-card">
        <h3>Linear Algebra Cheat Sheet</h3>
