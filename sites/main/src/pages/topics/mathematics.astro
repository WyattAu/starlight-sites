        <span class="site-card-meta">Distributions & Tests | 20+ formulas</span>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2>Related Topics</h2>
    </div>
    <div class="site-grid" data-cols="3">
