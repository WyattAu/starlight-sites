---
import ClientRouter from "astro/components/ClientRouter.astro"
import {
  generateArticleSchema,
  generateBreadcrumbSchema,
  generateCourseSchema,
  generateFAQSchema,
  generateHowToSchema,
  generateImageObjectSchema,
  generateOrganizationSchema,
  generateSoftwareSourceCodeSchema,
  generateVideoObjectSchema,
  generateWebSiteSchema,
  generatePersonSchema,
} from '../../utils/jsonld'

const { starlightRoute } = Astro.locals;
const { entry, head, id } = starlightRoute;

const pageTitle = entry?.data?.title || "Untitled";
const siteTitle = starlightRoute?.siteTitle || "Wyatt's Notes";

const description = entry?.data?.description || 'Free study notes, revision guide, and exam preparation with worked examples for IB, A-Level, GCSE, AP, DSE, and university STEM subjects.';
const site = 'https://wyattsnotes.wyattau.com';
const pageUrl = Astro.url.href;

// Get the current date for schema fallback
const currentDate = new Date().toISOString();

// Use frontmatter dates if available, otherwise fallback to current date
const datePublished = entry?.data?.datePublished || entry?.data?.date || currentDate;
const dateModified = entry?.data?.dateModified || entry?.data?.date || currentDate;

// Determine the site name from the URL
const urlParts = new URL(pageUrl).hostname.split('.');
const subdomain = urlParts.length > 2 ? urlParts[0] : 'www';
const siteName = subdomain === 'www' || subdomain === 'wyattsnotes' ? "Wyatt's Notes" : `${subdomain.charAt(0).toUpperCase() + subdomain.slice(1)} | Wyatt's Notes`;

// Cross-site canonical: related sites that share content topics
const relatedSiteGroups: Record<string, string[]> = {
  'exam-boards': ['dse', 'ib', 'alevel', 'gcse', 'ap', 'highers', 'leaving-cert', 'cbse', 'gaokao', 'hsc', 'sat'],
  'programming': ['cpp', 'python', 'java', 'rust', 'go', 'kotlin', 'swift', 'typescript', 'dart', 'ruby', 'haskell', 'elixir'],
  'cs-infrastructure': ['databases', 'networking', 'linux', 'security', 'tools', 'truenas', 'tuning', 'licensing'],
  'sciences': ['physics', 'chemistry', 'mathematics', 'computer-science', 'machine-learning'],
};

// Shared topics across exam board sites (top-level paths that exist on multiple boards)
const sharedExamTopics = [
  'physics', 'chemistry', 'maths', 'mathematics', 'biology', 'computer-science',
  'economics', 'english', 'geography', 'history', 'ict',
];
// Shared topics across programming sites
const sharedProgrammingTopics = [
  'fundamentals', 'concurrency', 'object-oriented', 'standard-library',
  'data-structures', 'error-handling', 'best-practices', 'async',
];
// Shared topics across CS infrastructure sites
const sharedInfraTopics = ['about'];
// Shared topics across science sites
const sharedScienceTopics = ['about'];

// Determine which group this site belongs to and what path segments to cross-link
function getRelatedSites(subdomain: string, pathSegments: string[]): string[] {
  const topPath = pathSegments[0] || '';

  for (const [, sites] of Object.entries(relatedSiteGroups)) {
    if (!sites.includes(subdomain)) continue;

    const peers = sites.filter(s => s !== subdomain);
    // Link to the top-level subject page on related sites if the path
    // starts with a topic that's shared across the group
    const sharedTopics =
      sites === relatedSiteGroups['exam-boards'] ? sharedExamTopics :
      sites === relatedSiteGroups['programming'] ? sharedProgrammingTopics :
      sites === relatedSiteGroups['cs-infrastructure'] ? sharedInfraTopics :
      sharedScienceTopics;

    if (topPath && sharedTopics.includes(topPath)) {
      return peers;
    }
  }
  return [];
}

const pagePathSegments = id.split('/').filter(Boolean);
const relatedSites = getRelatedSites(subdomain, pagePathSegments);
const canonicalBase = pageUrl.replace(/username\.github\.io|wyattau\.github\.io/g, 'wyattau.com').replace(/gitlab\.io/g, 'wyattau.com');

// Build breadcrumb trail from the page id (the slug) - matches PageTitle.astro logic
function buildBreadcrumbs(id: string, siteTitle: string) {
  const parts = id.split('/').filter(Boolean);
  const crumbs = [{ name: 'Home', url: 'https://wyattau.com' }];

  // Add site name as second breadcrumb
  const hostname = Astro.url.hostname;
  const siteUrl = `https://${hostname}`;
  crumbs.push({ name: siteTitle, url: siteUrl });

  let path = '';
  for (let i = 0; i < parts.length; i++) {
    path += `/${parts[i]}`;
    const isLast = i === parts.length - 1;
    // Convert slug to readable label: "1_forces-and-motion" → "Forces and Motion"
    const label = parts[i]
      .replace(/^\d+-/, '')        // Remove leading number prefix
      .replace(/^\d+_/, '')        // Remove leading number_ prefix
      .replace(/[-_]/g, ' ')       // Replace hyphens/underscores with spaces
      .replace(/\b\w/g, c => c.toUpperCase()); // Capitalize words

    if (isLast) {
      crumbs.push({ name: label, url: pageUrl });
    } else {
      crumbs.push({ name: label, url: `${siteUrl}${path}/` });
    }
  }
  return crumbs;
}

const breadcrumbItems = buildBreadcrumbs(id, siteTitle);

// Generate schemas using shared utilities
const organizationSchema = generateOrganizationSchema()
const websiteSchema = generateWebSiteSchema()
const articleSchema = generateArticleSchema({
  headline: pageTitle,
  description,
  url: pageUrl,
  datePublished,
  dateModified,
})
const breadcrumbSchema = generateBreadcrumbSchema({
  items: breadcrumbItems,
})

// Only generate page-specific schemas when frontmatter data exists
const hasFAQ = entry?.data?.faq && Array.isArray(entry.data.faq) && entry.data.faq.length > 0;
const hasHowTo = entry?.data?.howTo && Array.isArray(entry.data.howTo) && entry.data.howTo.steps?.length > 0;
const hasCourse = entry?.data?.course?.name;
const hasVideo = entry?.data?.video?.name;
const hasImage = entry?.data?.image?.url;
const hasCode = entry?.data?.code?.name;

// Generate FAQ schema from frontmatter or fallback to site-wide FAQ for homepage only
const faqSchema = hasFAQ
  ? generateFAQSchema(entry.data.faq)
  : subdomain === 'www' || subdomain === 'wyattsnotes'
    ? generateFAQSchema([
        {
          question: 'What are Wyatt\'s Notes?',
          answer: 'Wyatt\'s Notes are free, rigorous study notes covering IB, A-Level, GCSE, AP, DSE, university STEM, and programming topics.',
        },
        {
          question: 'Are the study notes free?',
          answer: 'Yes, all study notes on Wyatt\'s Notes are completely free and open to everyone.',
        },
      ])
    : null

// Generate HowTo schema from frontmatter or fallback for study guides
const howToSchema = hasHowTo
  ? generateHowToSchema(entry.data.howTo)
  : entry?.data?.layout === 'study-guide'
    ? generateHowToSchema({
        name: pageTitle,
        description,
        steps: [
          { name: 'Read the introduction', text: 'Read the introductory section to understand the context and prerequisites.' },
          { name: 'Study the main content', text: 'Go through the main content sections, reviewing examples and explanations.' },
          { name: 'Practice with examples', text: 'Apply what you learned by working through the practice problems and examples.' },
        ],
      })
    : null

// Generate Course schema from frontmatter or fallback for subject pages
const courseSchema = hasCourse
  ? generateCourseSchema(entry.data.course)
  : entry?.data?.layout === 'subject'
    ? generateCourseSchema({
        name: siteTitle,
        description: 'Free, rigorous study notes for IB, A-Level, GCSE, AP, DSE, university STEM, and programming.',
      })
    : null

// Generate optional schemas from frontmatter
const videoSchema = hasVideo ? generateVideoObjectSchema(entry.data.video) : null
const imageSchema = hasImage ? generateImageObjectSchema(entry.data.image) : null
const codeSchema = hasCode ? generateSoftwareSourceCodeSchema(entry.data.code) : null
const personSchema = generatePersonSchema()
---

<!-- Page speed: preconnect to external origins -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://search.wyattau.com" crossorigin />

<!-- Page speed: DNS prefetch for external services -->
<link rel="dns-prefetch" href="https://www.google-analytics.com" />
<link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

<!-- Page speed: DNS prefetch for subdomains -->
<link rel="dns-prefetch" href="https://dse.wyattau.com" />
<link rel="dns-prefetch" href="https://ib.wyattau.com" />
<link rel="dns-prefetch" href="https://alevel.wyattau.com" />
<link rel="dns-prefetch" href="https://gcse.wyattau.com" />
<link rel="dns-prefetch" href="https://ap.wyattau.com" />
<link rel="dns-prefetch" href="https://cpp.wyattau.com" />
<link rel="dns-prefetch" href="https://python.wyattau.com" />
<link rel="dns-prefetch" href="https://rust.wyattau.com" />
<link rel="dns-prefetch" href="https://mathematics.wyattau.com" />
<link rel="dns-prefetch" href="https://physics.wyattau.com" />

<!-- Page speed: preload critical assets (only for ES modules) -->

<script>
  (function() {
    try {
      const saved = localStorage.getItem('wn-theme');
      if (saved && ['dark','light','sepia','contrast','nord','dracula','monokai','ayu-mirage','solarized','papercolor'].includes(saved)) {
        document.documentElement.setAttribute('data-theme', saved);
      }
      const fs = localStorage.getItem('wn-font-size');
      if (fs) document.documentElement.style.setProperty('--wn-font-size-scale', fs);
      const lh = localStorage.getItem('wn-line-height');
      if (lh) document.documentElement.style.setProperty('--wn-line-height', lh);
      const cw = localStorage.getItem('wn-content-width');
      if (cw) document.documentElement.style.setProperty('--wn-content-width', cw);
      const ff = localStorage.getItem('wn-font-family');
      if (ff === 'serif') document.documentElement.style.setProperty('--wn-font-body', '"Merriweather", Georgia, serif');
      else if (ff === 'mono') document.documentElement.style.setProperty('--wn-font-body', '"JetBrains Mono", "Fira Code", monospace');
      const j = localStorage.getItem('wn-justify');
      if (j) document.documentElement.setAttribute('data-justify', j);
      const rm = localStorage.getItem('wn-reduce-motion');
      if (rm) document.documentElement.setAttribute('data-reduce-motion', rm);
    } catch(e) {}
  })();
</script>

<!-- SEO Meta Tags -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<!-- Canonical URL: always point to wyattau.com to avoid duplicate content -->
<link rel="canonical" href={canonicalBase} />

<!-- Hreflang for i18n -->
<link rel="alternate" hreflang="en" href={canonicalBase} />
<link rel="alternate" hreflang="x-default" href={canonicalBase} />

<!-- Cross-site alternate links for related sites (SEO: signals content relationship) -->
{relatedSites.map(relatedSub => {
  const relatedPath = `/${pagePathSegments.join('/')}`;
  const relatedUrl = `https://${relatedSub}.wyattau.com${relatedPath === '/' ? '/' : relatedPath + '/'}`;
  return <link rel="alternate" hreflang="en" href={relatedUrl} data-related-site={relatedSub} />;
})}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="article" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={`${new URL(pageUrl).origin}/img/social-card.svg`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@wyattau" />
<meta name="twitter:creator" content="@wyattau" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${new URL(pageUrl).origin}/img/social-card.svg`} />

<!-- Additional SEO Meta -->
<meta name="author" content="Wyatt" />
<meta name="generator" content={Astro.generator} />

<!-- Starlight head items (title, KaTeX CSS, analytics, font preloads, etc.) -->
{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script is:inline>
(function() {
  function registerSW() {
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').then(function(reg) {
        reg.addEventListener('updatefound', function() {
          var newSW = reg.installing
          newSW.addEventListener('statechange', function() {
            if (newSW.state === 'installed' && navigator.serviceWorker.controller) {
              newSW.postMessage({ type: 'SKIP_WAITING' })
            }
          })
        })
      }).catch(function(err) {
        // SW registration failed
      })
      navigator.serviceWorker.addEventListener('controllerchange', function() {
        window.location.reload()
      })
    }
  }
  // Defer SW registration to not block rendering
  if ('requestIdleCallback' in window) {
    requestIdleCallback(registerSW, { timeout: 5000 })
  } else {
    setTimeout(registerSW, 1000)
  }
})()
</script>

<!-- Reading controls (floating settings, focus mode, progress, position memory) -->
<script src="/reader.js" defer></script>

<!-- Site navigator: inject Sites button into Starlight header -->
<script is:inline>
(function(){
  function injectSitesButton(){
    var search = document.querySelector('#custom-search') || document.querySelector('.right-group')
    if(!search || !search.parentNode) return
    var btn = document.createElement('button')
    btn.className = 'site-nav-btn'
    btn.id = 'site-nav-trigger'
    btn.setAttribute('aria-label','Browse all sites')
    btn.setAttribute('title','Browse all sites')
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg><span>Sites</span>'
    search.parentNode.insertBefore(btn, search)
    btn.addEventListener('click', function(e){
      e.stopPropagation()
      var ov = document.getElementById('site-nav-overlay')
      if(!ov) ov = buildOverlay()
      ov.setAttribute('aria-hidden','false')
      document.body.classList.add('site-nav-open')
    })
  }
  function buildOverlay(){
    var SITES={'Exam Boards':[{n:'DSE',u:'https://dse.wyattau.com'},{n:'IB',u:'https://ib.wyattau.com'},{n:'A-Level',u:'https://alevel.wyattau.com'},{n:'GCSE',u:'https://gcse.wyattau.com'},{n:'AP',u:'https://ap.wyattau.com'},{n:'Highers',u:'https://highers.wyattau.com'},{n:'Leaving Cert',u:'https://leaving-cert.wyattau.com'},{n:'CBSE',u:'https://cbse.wyattau.com'},{n:'Gaokao',u:'https://gaokao.wyattau.com'},{n:'HSC',u:'https://hsc.wyattau.com'},{n:'SAT',u:'https://sat.wyattau.com'}],'Computer Science':[{n:'C++',u:'https://cpp.wyattau.com'},{n:'Java',u:'https://java.wyattau.com'},{n:'Python',u:'https://python.wyattau.com'},{n:'Rust',u:'https://rust.wyattau.com'},{n:'Go',u:'https://go.wyattau.com'},{n:'Kotlin',u:'https://kotlin.wyattau.com'},{n:'TypeScript',u:'https://typescript.wyattau.com'},{n:'Dart',u:'https://dart.wyattau.com'},{n:'Swift',u:'https://swift.wyattau.com'},{n:'Ruby',u:'https://ruby.wyattau.com'},{n:'Haskell',u:'https://haskell.wyattau.com'},{n:'Elixir',u:'https://elixir.wyattau.com'},{n:'Languages',u:'https://languages.wyattau.com'},{n:'Tools',u:'https://tools.wyattau.com'}],'Further Studies':[{n:'Mathematics',u:'https://mathematics.wyattau.com'},{n:'Physics',u:'https://physics.wyattau.com'},{n:'Chemistry',u:'https://chemistry.wyattau.com'},{n:'CS Theory',u:'https://computer-science.wyattau.com'},{n:'Admissions',u:'https://admissions.wyattau.com'}],'Infrastructure':[{n:'Networking',u:'https://networking.wyattau.com'},{n:'Linux',u:'https://linux.wyattau.com'},{n:'Security',u:'https://security.wyattau.com'},{n:'Databases',u:'https://databases.wyattau.com'},{n:'TrueNAS',u:'https://truenas.wyattau.com'},{n:'Tuning',u:'https://tuning.wyattau.com'},{n:'Licensing',u:'https://licensing.wyattau.com'},{n:'ML',u:'https://machine-learning.wyattau.com'}]}
    var cats=Object.keys(SITES)
    var el=document.createElement('div')
    el.id='site-nav-overlay'
    el.setAttribute('aria-hidden','true')
    el.innerHTML='<div class="site-nav-backdrop"></div><div class="site-nav-panel" role="dialog" aria-label="Site navigator"><div class="site-nav-header"><h2>All Sites</h2><button class="site-nav-close" aria-label="Close"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button></div><div class="site-nav-body">'+cats.map(function(c){return '<div class="site-nav-category"><div class="site-nav-cat-header"><span>'+c+'</span></div><div class="site-nav-grid">'+SITES[c].map(function(s){return '<a href="'+s.u+'" class="site-nav-card" target="_blank" rel="noopener"><strong>'+s.n+'</strong></a>'}).join('')+'</div></div>'}).join('')+'</div></div>'
    document.body.appendChild(el)
    el.querySelector('.site-nav-close').addEventListener('click',function(){el.setAttribute('aria-hidden','true');document.body.classList.remove('site-nav-open')})
    el.querySelector('.site-nav-backdrop').addEventListener('click',function(){el.setAttribute('aria-hidden','true');document.body.classList.remove('site-nav-open')})
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&el.getAttribute('aria-hidden')==='false'){el.setAttribute('aria-hidden','true');document.body.classList.remove('site-nav-open')}})
    return el
  }
  // Defer site nav injection to not block rendering
  function init() {
    if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',injectSitesButton)}else{injectSitesButton()}
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(init, { timeout: 3000 })
  } else {
    setTimeout(init, 500)
  }
})()
</script>

<!-- Cross-site search (injected into nav header) -->
<script src="/cross-site-search.js" defer></script>
<script src="/page-search.js" defer></script>

<!-- Mermaid: load library from CDN, then render diagrams -->
<script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script src="/mermaid-render.js" defer></script>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
{courseSchema && <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />}
{videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}
{imageSchema && <script type="application/ld+json" set:html={JSON.stringify(imageSchema)} />}
{codeSchema && <script type="application/ld+json" set:html={JSON.stringify(codeSchema)} />}
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="Wyatt's Notes RSS" href="/rss.xml" />

<ClientRouter />
