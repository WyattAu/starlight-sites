---
import ClientRouter from "astro/components/ClientRouter.astro"
/**
 * Head override for Starlight that adds JSON-LD structured data.
 *
 * This component extends Starlight's default Head to inject schema.org
 * structured data for better SEO and search engine visibility.
 *
 * Usage: Add to Starlight components config:
 *   components: {
 *     Head: './src/components/starlight/Head.astro',
 *   }
 */

interface Props {
  title?: string
  description?: string
  site?: string
  pageUrl?: string
}

const {
  title = "Wyatt's Notes",
  description = 'Free, rigorous study notes',
  site = 'https://wyattsnotes.wyattau.com',
  pageUrl = Astro.url.href,
} = Astro.props

// Generate WebSite schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: "Wyatt's Notes",
  description: 'Free, rigorous study notes for IB, A-Level, GCSE, AP, DSE, university STEM, and programming.',
  url: site,
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://search.wyattau.com/api/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
}

// Generate Article schema for content pages
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'Wyatt',
  },
  publisher: {
    '@type': 'Organization',
    name: "Wyatt's Notes",
    url: site,
  },
  url: pageUrl,
  datePublished: new Date().toISOString(),
  dateModified: new Date().toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
}
---

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<ClientRouter />
