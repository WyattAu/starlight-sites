---
interface Props {
  level: 'beginner' | 'intermediate' | 'advanced';
}

const { level } = Astro.props;
const colors = {
  beginner: { bg: 'rgba(6, 214, 160, 0.1)', text: '#06d6a0' },
  intermediate: { bg: 'rgba(255, 193, 7, 0.1)', text: '#ffc107' },
  advanced: { bg: 'rgba(239, 71, 111, 0.1)', text: '#ef476f' },
};
const color = colors[level];
---

<span class="difficulty-badge" style={`background: ${color.bg}; color: ${color.text}`}>
  {level}
</span>

<style>
  .difficulty-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: capitalize;
  }
</style>
