---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Search these notes',
    description: 'Full-text search across every page on this site.',
  }}
>
  <div class="pagefind-host">
    <div id="pagefind-search"></div>
    <noscript>Search requires JavaScript.</noscript>
  </div>
</StarlightPage>

<style>
  .pagefind-host :global(.pagefind-ui__search-input) {
    width: 100%;
  }
</style>

<script>
  import '@pagefind/default-ui/css/ui.css';
  import { PagefindUI } from '@pagefind/default-ui';

  const host = document.getElementById('pagefind-search');
  if (host) new PagefindUI({ element: '#pagefind-search', showSubResults: true });
</script>
