---
/**
 * PageFrame override, wraps every page inside <body>.
 *
 * - Landing pages (docs entry `index` with the splash template) render a
 *   full-bleed subject landing: the site Header, the SubjectHero Ken Burns
 *   hero, a sidebar-derived TopicGrid, then the stock content flow (which
 *   provides the markdown prose and the Footer) inside <slot />.
 * - Every other page falls through to Starlight's stock PageFrame.
 *
 * The stock Hero component is overridden to render nothing (see Hero.astro)
 * so the hero frontmatter can drive SubjectHero here without Starlight also
 * rendering its own hero panel.
 */
import PageFrame from '@astrojs/starlight/components/PageFrame.astro'
import ProgressPanel from '../ProgressPanel.tsx'
import SubjectHero from '../SubjectHero.astro'
import ThemeCreator from '../ThemeCreator.tsx'
import TopicGrid from '../TopicGrid.astro'
import Header from './Header.astro'

const { starlightRoute } = Astro.locals
const { entry } = starlightRoute

const isLanding =
  (entry.id === '' || entry.id === 'index') && entry.data.template === 'splash'

const title = entry.data.title
const tagline = entry.data.hero?.tagline || entry.data.description || ''
const actions = entry.data.hero?.actions ?? []

interface TopicCard {
  title: string
  description?: string
  href: string
}

const UTILITY_LABEL = /^(about|glossary|study hub|practice test|practice-test)$/i

interface SidebarLink {
  type: 'link'
  label: string
  href: string
}

interface SidebarGroup {
  type: 'group'
  label: string
  entries: SidebarEntry[]
}

type SidebarEntry = SidebarLink | SidebarGroup

function flattenSidebar(entries: SidebarEntry[]): TopicCard[] {
  const cards: TopicCard[] = []
  for (const e of entries) {
    if (e.type === 'link') {
      if (!UTILITY_LABEL.test(e.label)) cards.push({ title: e.label, href: e.href })
    } else if (e.type === 'group') {
      const first = e.entries.find(c => c.type === 'link')
      if (first) {
        cards.push({
          title: e.label,
          href: first.href,
          description: `${e.entries.length} ${e.entries.length === 1 ? 'topic' : 'topics'}`,
        })
      }
    }
  }
  return cards
}

const sidebar = starlightRoute.sidebar ?? []

// The Core Course is not a topic: it is the site's centre of gravity, and
// the encyclopaedia grid must not list it as track 02. Pull it out of the
// grid and give it its own feature panel above the encyclopaedia.
const courseGroup = sidebar.find(
  (e) => e.type === 'group' && /^the core course$/i.test(e.label),
)
const course =
  courseGroup?.type === 'group'
    ? {
        href: (courseGroup.entries.find((c) => c.type === 'link') ?? { href: '/17-core-course/' })
          .href,
        pages: courseGroup.entries.length,
        syllabus: courseGroup.entries
          .filter((c) => c.type === 'link')
          .map((c) => ({ label: c.label, href: c.href })),
      }
    : undefined
const topics = flattenSidebar(sidebar).filter((t) => {
  if (courseGroup?.type !== 'group') return true
  return !(t.title === courseGroup.label || t.href.startsWith('/17-core-course'))
})
---

{
  isLanding ? (
    <div class="page sl-flex landing">
      <header class="landing-header">
        <Header />
      </header>
      <div class="main-frame landing-frame landing-frame--syllabus">
        {course && course.syllabus.length > 0 && (
          <aside class="landing-syllabus" aria-label="Course syllabus">
            <p class="landing-syllabus__kicker">The syllabus</p>
            <ol class="landing-syllabus__list">
              {course.syllabus.map((s) => (
                <li class="landing-syllabus__item">
                  <a href={s.href}>{s.label}</a>
                </li>
              ))}
            </ol>
            <a class="landing-syllabus__cta" href={course.href}>
              Course overview
              <span aria-hidden="true">&rarr;</span>
            </a>
          </aside>
        )}
        <div class="landing-main">
        <SubjectHero title={title} tagline={tagline} image="/img/hero/library.avif" imageAlt="">
          {actions.length > 0 && (
            <div class="landing-cta" slot="actions">
              {actions.map((a) => (
                <a class="landing-cta__btn" href={a.link}>
                  {a.text}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>
          )}
        </SubjectHero>
        <ProgressPanel client:idle />
        {course && (
          <section class="landing-course" aria-label="The course">
            <div class="landing-course__inner">
              <p class="landing-kicker reveal">The course</p>
              <h2 class="landing-heading">
                Start from literacy. Walk to the research frontier.
              </h2>
              <p class="landing-course__desc">
                One linear path, dependency-ordered and machine-checked:
                nothing assumes anything you have not met. Twelve chapters
                are live; the full map runs eighty-nine chapters from logic
                to the research frontier.
              </p>
              <a class="landing-cta__btn" href={course.href}>
                Enter the course
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </section>
        )}
        {topics.length > 0 && (
          <section class="landing-topics" aria-label="Topics">
            <div class="landing-topics__inner">
              <p class="landing-kicker reveal">Browse the encyclopaedia</p>
              <h2 class="landing-heading">Reference tracks</h2>
              <TopicGrid topics={topics} columns={3} />
            </div>
          </section>
        )}
        <slot />
      </div>
      </div>
    </div>
  ) : (
    <PageFrame>
      <slot name="header" slot="header" />
      <slot name="sidebar" slot="sidebar" />
      {/* Renders nothing until the reader panel's Custom chip opens it, so
          the custom-theme creator is reachable on every doc page even
          though the Header override is not wired for doc pages. */}
      <ThemeCreator client:idle />
      <slot />
    </PageFrame>
  )
}

<style>
  /* Landing-only styles, scoped to the .landing wrapper rendered above. */

  /* The syllabus rail: the course outline visible on the landing at
     desktop widths; hidden on mobile (the course panel carries the
     structure there). */
  .landing-frame--syllabus {
    display: grid;
    grid-template-columns: 15.5rem minmax(0, 1fr);
    align-items: start;
  }
  .landing-syllabus {
    position: sticky;
    top: var(--sl-nav-height, 4rem);
    max-height: calc(100vh - var(--sl-nav-height, 4rem));
    overflow-y: auto;
    padding: 1.25rem 1rem;
    border-inline-end: 1px solid var(--sl-color-gray-6, var(--sl-color-gray-5, #2a2a3a));
    background: var(--sl-color-bg-sidebar, var(--sl-color-bg, transparent));
  }
  .landing-syllabus__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3, var(--sl-color-gray-4, #8888a0));
  }
  .landing-syllabus__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .landing-syllabus__item a {
    display: block;
    padding: 0.3rem 0.5rem;
    border-radius: 0.4rem;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2, var(--sl-color-gray-3, #c0c0d0));
    text-decoration: none;
  }
  .landing-syllabus__item a:hover {
    background: var(--sl-color-gray-6, var(--sl-color-gray-5, #2a2a3a));
    color: var(--sl-color-text, var(--sl-color-white, #e2e8f0));
  }
  .landing-syllabus__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.75rem 0.5rem 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-text-accent, var(--sl-color-accent, #ff6b35));
    text-decoration: none;
  }
  .landing-syllabus__cta:hover {
    text-decoration: underline;
  }
  @media (max-width: 60rem) {
    .landing-frame--syllabus {
      grid-template-columns: minmax(0, 1fr);
    }
    .landing-syllabus {
      display: none;
    }
  }

  /* The course feature panel: the site's centre of gravity, visually
     distinct from the encyclopaedia grid below it. */
  .landing-course {
    background: var(--sl-color-bg-cover, rgba(0, 0, 0, 0.04));
    border-block: 1px solid var(--sl-color-gray-6, var(--sl-color-gray-5, #2a2a3a));
    padding: calc(var(--sl-nav-pad-y) * 3) var(--sl-nav-pad-x);
  }
  .landing-course__inner {
    max-width: var(--sl-content-width, 72rem);
    margin-inline: auto;
  }
  .landing-course .landing-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--sl-color-accent, #ff6b35);
    background: var(--sl-color-accent, #ff6b35);
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 0.5rem;
  }
  .landing-course .landing-cta__btn:hover {
    background: var(--sl-color-accent-deep, #e55a2b);
    border-color: var(--sl-color-accent-deep, #e55a2b);
  }
  .landing-course__desc {
    max-width: 44rem;
    margin: 0.75rem 0 1.25rem;
    color: var(--sl-color-gray-3, var(--sl-color-gray-4, #8888a0));
    line-height: 1.7;
  }

  .landing-header {
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    z-index: var(--sl-z-index-navbar);
    width: 100%;
    height: var(--sl-nav-height);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
  }
  .landing .landing-frame {
    padding-top: var(--sl-nav-height);
    padding-inline-start: 0;
    /* Starlight's stock .main-frame is sized for a sidebar-and-content grid.
       On the landing variant there is no sidebar, so the frame must span the
       viewport -- otherwise the full-bleed hero renders at ~69% width with an
       empty panel to its right. Verified by forcing this in the browser:
       992px -> 1440px at a 1440px viewport. */
    width: 100%;
    max-width: none;
  }
  .landing-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 1.75rem;
  }
  .landing-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border: 1px solid rgba(247, 243, 234, 0.35);
    background: rgba(247, 243, 234, 0.08);
    color: #f7f3ea;
    font-family: var(--ea-font-mono);
    font-size: var(--ea-size-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 0.3s var(--ea-ease),
      border-color 0.3s var(--ea-ease),
      transform 0.3s var(--ea-ease);
  }
  .landing-cta__btn:hover {
    background: rgba(247, 243, 234, 0.16);
    border-color: rgba(247, 243, 234, 0.6);
    transform: translateY(-2px);
  }
  .landing-topics {
    padding: var(--ea-space-section) 1.5rem;
  }
  .landing-topics__inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .landing-kicker {
    font-family: var(--ea-font-mono);
    font-size: var(--ea-size-micro);
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ea-gold);
    margin: 0 0 0.6rem;
  }
  .landing-heading {
    font-family: var(--ea-font-display);
    font-weight: 300;
    font-size: var(--ea-size-h1);
    letter-spacing: -0.02em;
    color: var(--wn-text, var(--ea-text));
    margin: 0 0 2rem;
  }
  /* Keep the stock prose panel readable below the full-width grid. */
  .landing :global(.content-panel .sl-container) {
    max-width: var(--wn-content-width, 720px);
  }
</style>

